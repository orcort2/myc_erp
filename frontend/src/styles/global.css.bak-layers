    var(--glass-bg-soft);
  border-color: var(--myc-line);
  color: var(--myc-text);
}

:root[data-theme="dark"] .icon-text-button,
:root[data-theme="dark"] .table-button,
html[data-theme="dark"] .icon-text-button,
html[data-theme="dark"] .table-button,
