.theme-dark .module-card h2,
.theme-dark .topbar__identity strong {
  color: var(--myc-text);
}

/* Los documentos físicos e imprimibles conservan fondo blanco. */
.field-sheet-page,
.field-sheet-document-header,
.ets-signature-canvas {
  color-scheme: light;
}

@media print {
  .field-sheet-page,
.field-sheet-document-header {
    background: #ffffff !important;
    color: #111111 !important;
  }
}

/* ==========================================================================
   MYC DESIGN SYSTEM V2.1 — REDUCCIÓN DE LUMINOSIDAD
   Ajuste posterior: superficies menos blancas y glass más sobrio.
   ========================================================================== */

:root {
  --myc-bg: #cfdadc;
  --myc-surface: #dbe4e6;
  --myc-surface-1: #dbe4e6;
  --myc-surface-2: #e5ebec;
  --myc-surface-3: #edf1f2;
  --myc-input: #f4f7f7;

  --myc-text: #203033;
  --myc-muted: #596b6e;
  --myc-soft-text: #596b6e;
  --myc-border: #b7c7ca;
  --myc-divider: #c8d4d6;

  --glass-bg: rgba(223, 233, 234, 0.46);
  --glass-bg-strong: rgba(230, 237, 238, 0.60);
  --glass-bg-soft: rgba(214, 226, 228, 0.34);
  --glass-border: rgba(240, 250, 250, 0.30);
  --glass-highlight: rgba(255, 255, 255, 0.28);
  --glass-shadow: 0 18px 48px rgba(8, 31, 36, 0.12);
  --glass-shadow-strong: 0 24px 62px rgba(8, 31, 36, 0.17);
}

.app-shell--module,
.app-shell--dashboard {
  background:
    radial-gradient(circle at 84% 11%, rgba(61, 183, 179, 0.11), transparent 30%),
    linear-gradient(145deg, #193b42 0%, #365960 24%, #91a9ad 56%, var(--myc-bg) 100%);
}

.topbar,
.workspace-header__summary,
.flow-strip,
.operations-band,
.dashboard-control-panel,
.dashboard-section-block,
.module-workspace__hero,
.module-workspace__panel,
.clients-list-panel,
.module-tabs {
  background:
    linear-gradient(145deg, rgba(231, 239, 240, 0.56), rgba(61, 183, 179, 0.06)),
    var(--glass-bg);
}

.module-card {
  background:
    linear-gradient(145deg, rgba(230, 238, 239, 0.52), rgba(61, 183, 179, 0.06) 48%, rgba(215, 226, 228, 0.24)),
    var(--glass-bg);
}

.clients-table__row,
.ets-summary-card,
.ets-summary-link,
.ets-work-order-folder,
.ets-signature-card,
.glass-card-mini,
.read-only-grid article,
.field-sheet-create-section,
.field-sheet-client-choice,
.field-sheet-client-summary,
.ets-field-sheet-work-order,
.ets-field-sheet-equipment-row,
.document-version-list button,
.document-version-list span {
  background:
    linear-gradient(145deg, rgba(231, 238, 239, 0.44), rgba(204, 217, 220, 0.24)),
    var(--glass-bg-soft);
}

.clients-table__row--clickable:hover,
.quotation-row-button:hover,
.quotation-row-button:focus-visible,
.ets-summary-card:hover,
.ets-summary-card:focus-visible {
  background:
    linear-gradient(145deg, rgba(234, 241, 242, 0.54), rgba(61, 183, 179, 0.10)),
    rgba(218, 228, 230, 0.52);
}

input,
select,
textarea,
.document-library-form input,
.document-library-form select,
.document-library-form textarea,
.document-library-filters input,
.document-library-filters select,
.client-form input,
.client-form select,
.client-form textarea,
.field-sheet-form-grid input,
.field-sheet-form-grid select,
.field-sheet-form-grid textarea,
.field-sheet-create-field input,
.field-sheet-create-field select,
.certificate-client-form input,
.certificate-client-form textarea,
.certificate-client-save-options input,
.inline-select-field select,
.ets-expedient-search input,
.field-sheet-results-row input {
  background: rgba(244, 247, 247, 0.86);
}

.icon-text-button,
.table-button {
  background: rgba(226, 235, 236, 0.72);
}

.icon-text-button:hover,
.table-button:hover {
  background: rgba(237, 242, 243, 0.90);
}

/* El modal ETS estaba acumulando demasiadas capas claras. */
.service-order-modal,
.quotation-detail-modal,
.client-modal {
  background:
    linear-gradient(145deg, rgba(221, 231, 233, 0.82), rgba(198, 215, 218, 0.60)),
    rgba(211, 224, 226, 0.78);
  border-color: rgba(242, 250, 250, 0.32);
}

/* Menor brillo en encabezados y paneles internos del ETS. */
.service-order-modal .quotation-detail-header,
.service-order-modal .ets-progress-panel,
.service-order-modal .ets-auth-panel,
.service-order-modal .ets-stage-note,
.service-order-modal .ets-active-context,
.service-order-modal .ets-modal-action-ribbon,
.service-order-modal .ets-expedient-search,
.service-order-modal .field-sheet-create-section {
  background:
    linear-gradient(145deg, rgba(228, 236, 237, 0.58), rgba(203, 218, 221, 0.34)),
    rgba(214, 226, 228, 0.48);
  border-color: rgba(11, 106, 117, 0.16);
}

/* Mantener blancos reales solo en documentos físicos e inputs donde sea necesario. */
.field-sheet-page,
.field-sheet-document-header,
.ets-signature-canvas {
  background: #ffffff;
}

/* ==========================================================================
   MYC DESIGN SYSTEM V2.2 — CONTRASTE Y MENOR FATIGA VISUAL
   Reduce superficies blancas y refuerza la legibilidad en modo claro.
   ========================================================================== */

:root {
  --myc-bg: #bccacc;
  --myc-surface: #c8d4d6;
  --myc-surface-1: #c8d4d6;
  --myc-surface-2: #d5dfe1;
  --myc-surface-3: #e2e9ea;
  --myc-input: #edf2f2;

  --myc-text: #10292e;
  --myc-muted: #40565a;
  --myc-soft-text: #40565a;
  --myc-placeholder: #718387;

  --myc-border: #9fb1b5;
  --myc-divider: #afbec1;
  --myc-line: rgba(7, 76, 86, 0.24);

  --glass-bg: rgba(188, 204, 207, 0.60);
  --glass-bg-strong: rgba(201, 214, 216, 0.74);
  --glass-bg-soft: rgba(173, 193, 197, 0.46);
  --glass-border: rgba(226, 238, 239, 0.30);
  --glass-highlight: rgba(255, 255, 255, 0.18);
  --glass-shadow: 0 18px 46px rgba(6, 28, 33, 0.16);
  --glass-shadow-strong: 0 24px 60px rgba(6, 28, 33, 0.22);
}

.app-shell--module,
.app-shell--dashboard {
  background:
    radial-gradient(circle at 84% 11%, rgba(61, 183, 179, 0.09), transparent 28%),
    linear-gradient(145deg, #17383f 0%, #2b5057 24%, #708d92 52%, #aebfc2 78%, var(--myc-bg) 100%);
}

/* Paneles principales: menos blanco,
más material. */
.topbar,
.workspace-header__summary,
.flow-strip,
.operations-band,
.dashboard-control-panel,
.dashboard-section-block,
.module-workspace__hero,
.module-workspace__panel,
.clients-list-panel,
.module-tabs,
.service-order-modal,
.quotation-detail-modal,
.client-modal {
  background:
    linear-gradient(145deg, rgba(205, 217, 219, 0.70), rgba(156, 181, 186, 0.28)),
    var(--glass-bg);
  border-color: rgba(225, 237, 238, 0.28);
  box-shadow: var(--glass-shadow);
}

/* Cards y métricas: evitar blanco puro. */
.module-card,
.operations-band__metric,
.dashboard-progress-summary,
.dashboard-executive-grid .operations-band__metric,
.dashboard-section-block .operations-band__metric,
.flow-strip span,
.clients-table__row,
.ets-summary-card,
.ets-summary-link,
.ets-work-order-folder,
.ets-signature-card,
.glass-card-mini,
.read-only-grid article,
.field-sheet-create-section,
.field-sheet-client-choice,
.field-sheet-client-summary,
.ets-field-sheet-work-order,
.ets-field-sheet-equipment-row,
.document-version-list button,
.document-version-list span {
  background:
    linear-gradient(145deg, rgba(216, 225, 227, 0.62), rgba(177, 195, 198, 0.30)),
    rgba(185, 201, 204, 0.48);
  border-color: rgba(7, 76, 86, 0.18);
}

/* Contraste tipográfico reforzado. */
.workspace-header h1,
.module-workspace__hero h1,
.module-workspace__panel h2,
.section-heading h2,
.topbar__identity strong,
.clients-table__head,
.read-only-grid strong,
.operations-band__metric strong,
.dashboard-progress-summary strong,
.dashboard-control-panel strong,
.dashboard-section-block strong,
.flow-strip span,
.ets-summary-card strong,
.ets-summary-link strong {
  color: #0b2a30;
}

.workspace-header span,
.module-workspace__hero span,
.module-workspace__panel p,
.module-card p,
.clients-table__row,
.operations-band__metric span,
.dashboard-progress-summary span,
.dashboard-control-panel span,
.dashboard-section-block span,
.ets-summary-card span,
.ets-summary-link span,
.field-sheet-form-grid label,
.client-form label,
.inline-select-field,
.ets-stage-note {
  color: #3f5559;
}

/* Tabs y bandas del dashboard */
.flow-strip span,
.module-tab,
.client-modal-tab,
.ets-folder-tab {
  background: rgba(210, 221, 223, 0.58);
  border-color: rgba(7, 76, 86, 0.16);
  color: #17383f;
}

.module-tab.is-active,
.client-modal-tab.is-active,
.ets-folder-tab.is-active {
  background:
    linear-gradient(145deg, rgba(175, 211, 210, 0.78), rgba(150, 190, 191, 0.54));
  border-color: rgba(11, 106, 117, 0.34);
  color: #0b4f58;
}

/* Inputs siguen siendo claramente editables,
pero sin blanco puro. */
input,
select,
textarea,
.document-library-form input,
.document-library-form select,
.document-library-form textarea,
.document-library-filters input,
.document-library-filters select,
.client-form input,
.client-form select,
.client-form textarea,
.field-sheet-form-grid input,
.field-sheet-form-grid select,
.field-sheet-form-grid textarea,
.field-sheet-create-field input,
.field-sheet-create-field select,
.certificate-client-form input,
.certificate-client-form textarea,
.certificate-client-save-options input,
.inline-select-field select,
.ets-expedient-search input,
.field-sheet-results-row input {
  background: rgba(232, 238, 239, 0.90);
  border-color: #9fb1b5;
  color: #10292e;
}

/* Botones secundarios más definidos. */
.icon-text-button,
.table-button {
  background: rgba(202, 214, 216, 0.78);
  border-color: rgba(7, 76, 86, 0.20);
  color: #12383f;
}

.icon-text-button:hover,
.table-button:hover {
  background: rgba(218, 226, 228, 0.92);
  border-color: rgba(11, 106, 117, 0.34);
}

/* Modal ETS: eliminar acumulación de capas claras. */
.service-order-modal .quotation-detail-header,
.service-order-modal .ets-progress-panel,
.service-order-modal .ets-auth-panel,
.service-order-modal .ets-stage-note,
.service-order-modal .ets-active-context,
.service-order-modal .ets-modal-action-ribbon,
.service-order-modal .ets-expedient-search,
.service-order-modal .field-sheet-create-section {
  background:
    linear-gradient(145deg, rgba(200, 213, 215, 0.70), rgba(163, 184, 188, 0.34)),
    rgba(184, 201, 204, 0.54);
  border-color: rgba(7, 76, 86, 0.18);
}

/* Hover con profundidad,
sin destello blanco. */
.clients-table__row--clickable:hover,
.quotation-row-button:hover,
.quotation-row-button:focus-visible,
.ets-summary-card:hover,
.ets-summary-card:focus-visible {
  background:
    linear-gradient(145deg, rgba(208, 220, 222, 0.72), rgba(119, 170, 173, 0.20)),
    rgba(180, 198, 201, 0.56);
  border-color: rgba(11, 106, 117, 0.38);
}

/* Documentos físicos permanecen blancos. */
.field-sheet-page,
.field-sheet-document-header,
.ets-signature-canvas {
  background: #ffffff;
  color: #111111;
}

/* ==========================================================================
   MYC DESIGN SYSTEM V2.3 — CONTRASTE SEGÚN CONTEXTO
   Regla: texto claro sobre fondos oscuros; texto oscuro dentro de glass claro.
   ========================================================================== */

:root {
  --myc-on-dark: #f1f8f8;
  --myc-on-dark-muted: #c2d2d4;
  --myc-on-dark-accent: #78ddd6;
}

/*
 * Encabezados de página colocados directamente sobre el fondo oscuro.
 * Estos no deben heredar el color oscuro usado dentro de tarjetas claras.
 */
.workspace > .workspace-header,
.app-shell--dashboard .workspace-header,
.app-shell--module .workspace-header {
  color: var(--myc-on-dark);
}

.workspace > .workspace-header h1,
.app-shell--dashboard .workspace-header h1,
.app-shell--module .workspace-header h1 {
  color: var(--myc-on-dark);
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.20);
}

.workspace > .workspace-header > div:first-child > p,
.app-shell--dashboard .workspace-header > div:first-child > p,
.app-shell--module .workspace-header > div:first-child > p {
  color: var(--myc-on-dark-accent);
}

.workspace > .workspace-header > div:first-child > span:not(.workspace-header__welcome),
.app-shell--dashboard .workspace-header > div:first-child > span:not(.workspace-header__welcome),
.app-shell--module .workspace-header > div:first-child > span:not(.workspace-header__welcome) {
  color: var(--myc-on-dark-muted);
}

/*
 * Los elementos que sí tienen una superficie clara propia conservan texto oscuro.
 */
.workspace-header__welcome {
  background:
    linear-gradient(145deg, rgba(216, 226, 228, 0.86), rgba(183, 201, 204, 0.70));
  border-color: rgba(235, 246, 247, 0.36);
  color: #12343a !important;
  text-shadow: none;
}

.workspace-header__summary,
.workspace-header__summary strong,
.workspace-header__summary span {
  text-shadow: none;
}

.workspace-header__summary strong {
  color: #0b4f58;
}

.workspace-header__summary span {
  color: #40565a;
}

/* Pantallas de autenticación y carga: fondo oscuro,
contenido claro. */
.auth-screen .auth-heading h1,
.loading-screen .auth-heading h1 {
  color: var(--myc-on-dark);
}

.auth-screen .auth-heading p,
.loading-screen .auth-heading p {
  color: var(--myc-on-dark-accent);
}

.auth-screen .auth-heading span,
.loading-screen .auth-heading span,
.auth-screen .auth-form label {
  color: var(--myc-on-dark-muted);
}

/* Navegación y zonas oscuras permanentes. */
.sidebar,
.sidebar strong,
.sidebar .nav-item,
.sidebar .lab-nav-list > span {
  color: var(--myc-on-dark);
}

.sidebar .brand-lockup span,
.sidebar .lab-nav-list > span {
  color: rgba(226, 239, 240, 0.68);
}

/* Menús oscuros o bloques de código. */
.json-preview,
.json-preview *,
.ets-admin-actions__menu.is-dark,
.ets-admin-actions__menu.is-dark * {
  color: var(--myc-on-dark);
}

/*
 * Protección contra reglas globales demasiado amplias:
 * dentro de paneles claros se restablece texto oscuro.
 */
.topbar,
.topbar *,
.module-workspace__hero,
.module-workspace__hero *,
.module-workspace__panel,
.module-workspace__panel *,
.dashboard-control-panel,
.dashboard-control-panel *,
.dashboard-section-block,
.dashboard-section-block *,
.operations-band,
.operations-band *,
.flow-strip,
.flow-strip *,
.clients-list-panel,
.clients-list-panel *,
.client-modal,
.client-modal *,
.service-order-modal,
.service-order-modal *,
.quotation-detail-modal,
.quotation-detail-modal * {
  text-shadow: none;
}

.topbar,
.module-workspace__hero,
.module-workspace__panel,
.dashboard-control-panel,
.dashboard-section-block,
.operations-band,
.flow-strip,
.clients-list-panel,
.client-modal,
.service-order-modal,
.quotation-detail-modal {
  color: var(--myc-text);
}

/* Textos secundarios dentro de superficies claras. */
.topbar span,
.module-workspace__hero span,
.module-workspace__panel p,
.dashboard-control-panel span,
.dashboard-section-block span,
.operations-band__metric span,
.clients-list-panel span,
.client-modal span,
.service-order-modal span,
.quotation-detail-modal span {
  color: var(--myc-muted);
}

/* Títulos dentro de superficies claras. */
.topbar strong,
.module-workspace__hero h1,
.module-workspace__panel h2,
.dashboard-control-panel h2,
.dashboard-section-block h2,
.operations-band__metric strong,
.clients-list-panel h2,
.client-modal h2,
.service-order-modal h2,
.quotation-detail-modal h2 {
  color: var(--myc-text);
}

/* En modo oscuro,
todas las superficies oscuras mantienen texto claro. */
:root[data-theme="dark"] .workspace-header h1,
html[data-theme="dark"] .workspace-header h1,
body[data-theme="dark"] .workspace-header h1,
.dark .workspace-header h1,
.dark-theme .workspace-header h1,
.theme-dark .workspace-header h1 {
  color: var(--myc-on-dark);
}

:root[data-theme="dark"] .workspace-header > div:first-child > p,
html[data-theme="dark"] .workspace-header > div:first-child > p,
body[data-theme="dark"] .workspace-header > div:first-child > p,
.dark .workspace-header > div:first-child > p,
.dark-theme .workspace-header > div:first-child > p,
.theme-dark .workspace-header > div:first-child > p {
  color: var(--myc-on-dark-accent);
}

:root[data-theme="dark"] .workspace-header > div:first-child > span:not(.workspace-header__welcome),
html[data-theme="dark"] .workspace-header > div:first-child > span:not(.workspace-header__welcome),
body[data-theme="dark"] .workspace-header > div:first-child > span:not(.workspace-header__welcome),
.dark .workspace-header > div:first-child > span:not(.workspace-header__welcome),
.dark-theme .workspace-header > div:first-child > span:not(.workspace-header__welcome),
.theme-dark .workspace-header > div:first-child > span:not(.workspace-header__welcome) {
  color: var(--myc-on-dark-muted);
}

.catalog-composite-editor {
  grid-column: 1 / -1;
  display: grid;
  gap: 12px;
  padding: 16px;
  border: 1px solid rgba(73, 101, 124, 0.2);
  border-radius: 16px;
  background: rgba(246, 249, 251, 0.88);
}

.catalog-item-name-cell {
  display: grid;
  gap: 3px;
}

.catalog-composite-editor__heading,
.catalog-composite-editor__row {
  display: flex;
  align-items: end;
  gap: 12px;
}

.catalog-composite-editor__heading {
  align-items: center;
  justify-content: space-between;
}

.catalog-composite-editor__heading > div,
.catalog-composite-editor__list {
  display: grid;
  gap: 8px;
}

.catalog-composite-editor__row label:first-child {
  flex: 1 1 360px;
}

.catalog-composite-editor__row label:nth-child(2) {
  flex: 0 0 120px;
}

@media (max-width: 760px) {
  .catalog-composite-editor__heading,
.catalog-composite-editor__row {
    align-items: stretch;
    flex-direction: column;
  }

  .catalog-composite-editor__row label:first-child,
.catalog-composite-editor__row label:nth-child(2) {
    flex-basis: auto;
    width: 100%;
  }
}

/* ==========================================================================\n   MYC DESIGN SYSTEM V2.4 — LIQUID GLASS PANORÁMICO\n   Base visual compartida por todo el ERP.\n   ========================================================================== */

:root {
  --myc-page-gap: 18px;
  --myc-page-radius: 20px;
  --myc-page-glass: rgba(214, 228, 229, 0.48);
  --myc-page-border: rgba(239, 250, 250, 0.30);
  --myc-page-shadow: 0 24px 68px rgba(6, 31, 38, 0.16);
}

.app-shell--module {
  grid-template-columns: 252px minmax(0, 1fr);
}

.app-shell--module.is-sidebar-collapsed {
  grid-template-columns: 78px minmax(0, 1fr);
}

.sidebar {
  padding: 20px 18px;
}

.workspace {
  max-width: none;
  padding: 18px clamp(18px, 1.8vw, 30px) 26px;
  width: 100%;
}

.app-shell--dashboard .workspace {
  max-width: none;
}

.topbar {
  border-radius: 14px;
  margin-bottom: 18px;
  min-height: 70px;
  overflow: visible;
  padding: 10px 16px;
  z-index: 100;
}

.workspace-header,
.module-workspace__hero,
.section-heading {
  margin-bottom: 16px;
}

.workspace-header h1,
.module-workspace__hero h1 {
  letter-spacing: -0.035em;
}

/* Superficies principales con el mismo lenguaje de Comunicaciones. */
.module-workspace__panel,
.dashboard-control-panel,
.dashboard-section-block,
.clients-list-panel,
.operations-band,
.flow-strip,
.module-tabs,
.document-library-panel,
.pattern-selection-panel {
  border-radius: var(--myc-page-radius);
  border-color: var(--myc-page-border);
  box-shadow: var(--myc-page-shadow);
}

.module-card,
.operations-band__metric,
.ets-summary-card,
.ets-work-order-folder,
.glass-card-mini,
.read-only-grid article {
  border-radius: 14px;
}

/* El contenido aprovecha el ancho real del monitor. */
.module-workspace,
.dashboard-home,
.clients-page,
.billing-page,
.settings-page,
.resolution-center-page,
.communications-page {
  width: 100%;
}

/* Scrollbars discretas y consistentes. */
* {
  scrollbar-color: rgba(47, 127, 112, 0.48) rgba(255, 255, 255, 0.18);
  scrollbar-width: thin;
}

*::-webkit-scrollbar {
  height: 9px;
  width: 9px;
}

*::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.18);
}

*::-webkit-scrollbar-thumb {
  background: rgba(47, 127, 112, 0.42);
  border: 2px solid transparent;
  border-radius: 999px;
  background-clip: padding-box;
}

*::-webkit-scrollbar-thumb:hover {
  background: rgba(47, 127, 112, 0.62);
  border: 2px solid transparent;
  background-clip: padding-box;
}

@media (max-width: 1100px) {
  .app-shell--module {
    grid-template-columns: 226px minmax(0, 1fr);
  }

  .workspace {
    padding-inline: 18px;
  }
}

/* ==========================================================================
   MYC DESIGN SYSTEM V3.0 — REFINAMIENTO VISUAL INTEGRAL
   Capa final deliberada: corrige densidad,
jerarquía y uso del espacio sin
   modificar la lógica funcional de los módulos.
   ========================================================================== */

:root {
  --myc-layout-gap: clamp(22px, 2.1vw, 34px);
  --myc-section-gap: clamp(28px, 3vw, 46px);
  --myc-card-radius: 18px;
  --myc-panel-radius: 24px;
  --myc-control-height: 44px;
  --myc-surface-border: rgba(239, 250, 250, 0.34);
  --myc-surface-shadow: 0 22px 58px rgba(3, 28, 36, 0.15);
}

.workspace {
  padding: 16px clamp(20px, 2.25vw, 38px) 38px;
}

.topbar {
  min-height: 66px;
  margin-bottom: clamp(22px, 2.3vw, 34px);
  padding: 9px 15px;
}

.workspace > .workspace-header,
.app-shell--dashboard .workspace-header,
.app-shell--module .workspace-header {
  align-items: flex-end;
  display: flex;
  gap: 24px;
  justify-content: space-between;
  margin: 0 0 var(--myc-section-gap);
  min-height: 104px;
}

.workspace-header > div:first-child {
  display: grid;
  gap: 7px;
}

.workspace > .workspace-header > div:first-child > p,
.app-shell--dashboard .workspace-header > div:first-child > p,
.app-shell--module .workspace-header > div:first-child > p {
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.19em;
  margin: 0;
  text-transform: uppercase;
}

.workspace > .workspace-header h1,
.app-shell--dashboard .workspace-header h1,
.app-shell--module .workspace-header h1 {
  font-size: clamp(30px, 3vw, 46px);
  line-height: 1.02;
  margin: 0;
}

.workspace-header__welcome {
  color: var(--myc-on-dark-muted);
  display: block;
  font-size: 13px;
  line-height: 1.5;
  margin-top: 2px;
}

.workspace-header__summary {
  border-radius: 18px;
  min-width: 170px;
  padding: 17px 20px;
}

.workspace-header__summary strong {
  font-size: clamp(26px, 2.4vw, 36px);
  line-height: 1;
}

.workspace-header__summary span {
  font-size: 11px;
  margin-top: 5px;
}

/* Se elimina visualmente cualquier remanente legado del flujo decorativo. */
.flow-strip {
  display: none !important;
}

.dashboard-control-panel {
  border-radius: var(--myc-panel-radius);
  margin: 0;
  padding: clamp(22px, 2.25vw, 34px);
}

.dashboard-control-panel__header {
  gap: 24px;
  margin-bottom: 20px;
}

.dashboard-control-panel__header p,
.dashboard-section-heading p {
  font-size: 10px;
  letter-spacing: 0.17em;
}

.dashboard-control-panel__header h2,
.dashboard-section-heading h2 {
  font-size: clamp(20px, 1.85vw, 28px);
  line-height: 1.15;
}

.dashboard-progress-summary {
  min-width: 150px;
}

.dashboard-progress-summary strong {
  font-size: clamp(25px, 2.35vw, 34px);
}

.dashboard-progress-bar {
  margin-bottom: 24px;
}

.dashboard-section-block {
  background: transparent;
  border: 0;
  box-shadow: none;
  margin-top: var(--myc-section-gap);
  padding: 0;
}

.dashboard-section-heading {
  display: grid;
  gap: 5px;
  margin: 0 0 18px;
}

.operations-band.dashboard-executive-grid {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(auto-fit, minmax(155px, 1fr));
}

.operations-band__metric {
  min-height: 112px;
  padding: 18px 16px;
}

.operations-band__metric strong {
  font-size: clamp(24px, 2.2vw, 32px);
  line-height: 1;
}

.operations-band__metric span {
  font-size: 11px;
  line-height: 1.35;
  margin-top: 8px;
}

.dashboard-executive-grid--compact .operations-band__metric {
  min-height: 100px;
}

.modules-grid {
  gap: clamp(16px, 1.55vw, 24px);
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
}

.module-card {
  border-radius: var(--myc-card-radius);
  min-height: 225px;
  padding: 20px;
}

.module-card__header {
  margin-bottom: 20px;
}

.module-card__icon {
  height: 44px;
  width: 44px;
}

.module-card h2 {
  font-size: 19px;
  margin-bottom: 8px;
}

.module-card p {
  font-size: 12px;
  line-height: 1.55;
}

.module-card__footer {
  margin-top: auto;
  padding-top: 18px;
}

/* Componentes compartidos: altura y respiración consistentes. */
button,
input,
select,
textarea {
  scroll-margin-top: 96px;
}

.icon-text-button,
.table-button,
.primary-button,
.secondary-button {
  min-height: var(--myc-control-height);
}

.module-tabs {
  gap: 7px;
  padding: 7px;
}

.module-tabs button {
  min-height: 40px;
  padding-inline: 14px;
}

.modal-card,
.modal-panel,
.service-order-modal,
.quotation-modal,
.client-modal {
  border-radius: var(--myc-panel-radius);
}

@media (max-width: 1180px) {
  .workspace > .workspace-header,
.app-shell--dashboard .workspace-header,
.app-shell--module .workspace-header {
    min-height: 94px;
  }

  .operations-band.dashboard-executive-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 820px) {
  .workspace {
    padding: 14px 14px 28px;
  }

  .topbar {
    margin-bottom: 22px;
  }

  .workspace > .workspace-header,
.app-shell--dashboard .workspace-header,
.app-shell--module .workspace-header {
    align-items: stretch;
    display: grid;
    margin-bottom: 28px;
    min-height: 0;
  }

  .workspace-header__summary {
    min-width: 0;
    width: 100%;
  }

  .dashboard-control-panel__header {
    align-items: stretch;
    display: grid;
  }

  .operations-band.dashboard-executive-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .modules-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 520px) {
  .operations-band.dashboard-executive-grid {
    grid-template-columns: 1fr;
  }

  .operations-band__metric,
.dashboard-executive-grid--compact .operations-band__metric {
    min-height: 92px;
  }
}

/* Título institucional compartido por los bloques y accesos del Dashboard. */
.dashboard-control-panel__header .dashboard-title,
.dashboard-section-heading .dashboard-title,
.activity-inbox-widget .dashboard-title {
  color: var(--dashboard-title-color);
}
