:root {
  /* MYC Design System V2 — Industrial Liquid Glass */
  color-scheme: light;

  --myc-primary: #0b6a75;
  --myc-primary-dark: #074c56;
  --myc-primary-hover: #095965;
  --myc-primary-active: #074c56;
  --dashboard-title-color: #eaf4f2;
  --myc-accent: #3db7b3;
  --myc-accent-soft: rgba(61, 183, 179, 0.16);

  --myc-navy: #082b30;
  --myc-exeption: #e8eef0;

  --myc-bg: #dce4e6;
  --myc-surface: #e8eef0;
  --myc-surface-1: #e8eef0;
  --myc-surface-2: #f2f5f6;
  --myc-surface-3: #f7f9fa;
  --myc-input: #fcfdfd;

  --myc-text: #243235;
  --myc-muted: #5f7073;
  --myc-soft-text: #5f7073;
  --myc-placeholder: #8b989c;

  --myc-border: #c6d4d8;
  --myc-divider: #d7e2e4;
  --myc-line: rgba(11, 106, 117, 0.18);

  --myc-sidebar: #082b30;
  --myc-sidebar-alt: #0c3840;

  --myc-success: #2d8c63;
  --myc-warning: #d29a1a;
  --myc-danger: #c44a47;
  --myc-info: #3a86c8;

  --glass-bg: rgba(255, 255, 255, 0.28);
  --glass-bg-strong: rgba(255, 255, 255, 0.38);
  --glass-bg-soft: rgba(255, 255, 255, 0.20);
  --glass-border: rgba(255, 255, 255, 0.32);
  --glass-shadow: 0 18px 50px rgba(10, 20, 25, 0.08);
  --glass-shadow-strong: 0 24px 64px rgba(10, 20, 25, 0.13);
  --glass-highlight: rgba(255, 255, 255, 0.58);

  --myc-radius-sm: 6px;
  --myc-radius-md: 8px;
  --myc-radius-lg: 12px;
  --myc-radius-xl: 18px;

  color: var(--myc-text);
  background: var(--myc-bg);
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

.quotation-exceptional-banner {
  align-items: center;
  background: color-mix(in srgb, var(--brand-primary, #174a7c) 10%, var(--panel-bg, #fff));
  border: 1px solid color-mix(in srgb, var(--brand-primary, #174a7c) 45%, transparent);
  border-radius: 16px;
  display: flex;
  gap: 18px;
  justify-content: space-between;
  margin-bottom: 18px;
  padding: 16px;
}

.quotation-exceptional-banner > div,
.quotation-unlock-summary__columns section,
.quotation-unlock-summary__columns article {
  display: grid;
  gap: 6px;
}

.quotation-exceptional-banner span {
  color: var(--muted-text, #64748b);
  font-size: 0.84rem;
}

.quotation-unlock-summary {
  max-width: 880px;
}

.quotation-unlock-summary__columns {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin: 18px 0;
}

.quotation-unlock-summary__columns section {
  background: var(--soft-surface, rgba(15, 23, 42, 0.04));
  border: 1px solid var(--border-color, rgba(15, 23, 42, 0.12));
  border-radius: 14px;
  padding: 14px;
}

.quotation-unlock-summary__columns article {
  border-top: 1px solid var(--border-color, rgba(15, 23, 42, 0.12));
  padding-top: 10px;
}

@media (max-width: 760px) {
  .quotation-exceptional-banner {
    align-items: stretch;
    flex-direction: column;
  }

  .quotation-unlock-summary__columns {
    grid-template-columns: 1fr;
  }
}
* {
  box-sizing: border-box;
}

html {
  background: var(--myc-bg);
}

body {
  margin: 0;
}

.document-library-grid {
  align-items: start;
  display: grid;
  gap: 18px;
  grid-template-columns: minmax(0, 1.6fr) minmax(320px, 0.8fr);
}

.document-library-panel {
  display: grid;
  gap: 18px;
}

.document-library-form {
  display: grid;
  gap: 10px;
}

.document-library-form input,
.document-library-form select,
.document-library-form textarea,
.document-library-filters input,
.document-library-filters select {
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid var(--myc-line);
  border-radius: 8px;
  color: var(--myc-text);
  min-height: 40px;
  padding: 9px 11px;
  width: 100%;
}

.document-library-form textarea {
  resize: vertical;
}

.document-library-filters {
  display: grid;
  gap: 8px;
  grid-template-columns: minmax(160px, 1fr) minmax(130px, 0.7fr) minmax(110px, 0.6fr) auto;
}

.document-version-list {
  display: grid;
  gap: 8px;
}

.document-version-list button,
.document-version-list span {
  align-items: center;
  background: rgba(255, 255, 255, 0.58);
  border: 1px solid var(--myc-line);
  border-radius: 8px;
  color: var(--myc-text);
  display: flex;
  justify-content: space-between;
  min-height: 38px;
  padding: 8px 10px;
  text-align: left;
}

.pattern-selection-panel {
  background: rgba(255, 255, 255, 0.58);
  border: 1px solid var(--myc-line);
  border-radius: 8px;
  display: grid;
  gap: 10px;
  margin-top: 10px;
  padding: 12px;
}

.pattern-selection-panel > strong,
.pattern-selection-panel > span {
  display: block;
}

.flow-test-grid {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(4, minmax(180px, 1fr));
}

.json-preview {
  background: rgba(5, 31, 45, 0.92);
  border: 1px solid rgba(201, 255, 247, 0.28);
  border-radius: 8px;
  color: #eaf4f2;
  font-size: 12px;
  line-height: 1.5;
  margin: 14px 0 0;
  max-height: 480px;
  overflow: auto;
  padding: 14px;
  white-space: pre-wrap;
}

@media (max-width: 1120px) {
  .document-library-grid,
.document-library-filters,
.flow-test-grid {
    grid-template-columns: 1fr;
  }
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.loading-screen,
.auth-screen,
.app-shell {
  background:
    linear-gradient(145deg, rgba(5, 31, 45, 0.98) 0%, rgba(5, 53, 66, 0.94) 38%, rgba(8, 117, 111, 0.18) 70%, rgba(234, 244, 242, 0.96) 100%),
    linear-gradient(90deg, rgba(70, 216, 196, 0.14), transparent 34%, rgba(255, 255, 255, 0.18)),
    repeating-linear-gradient(135deg, rgba(201, 255, 247, 0.07) 0 1px, transparent 1px 34px);
  min-height: 100vh;
}

.loading-screen,
.auth-screen {
  align-items: center;
  color: #ffffff;
  display: flex;
  padding: 24px;
}

.loading-screen {
  gap: 14px;
  justify-content: center;
}

.auth-screen {
  justify-content: flex-start;
}

.auth-panel {
  backdrop-filter: blur(24px) saturate(142%);
  background: var(--glass-bg-strong);
  border: 1px solid var(--glass-border);
  border-radius: 8px;
  box-shadow: var(--glass-shadow);
  color: var(--myc-text);
  margin-left: clamp(0px, 8vw, 110px);
  padding: 28px;
  position: relative;
  overflow: hidden;
  width: min(440px, 100%);
}

.auth-panel::before,
.module-card__shine {
  background: linear-gradient(120deg, rgba(255, 255, 255, 0.95), rgba(70, 216, 196, 0.24), rgba(255, 255, 255, 0));
  content: "";
  height: 1px;
  left: 14px;
  position: absolute;
  right: 14px;
  top: 12px;
}

.brand-lockup,
.topbar__identity,
.operations-band__metric {
  align-items: center;
  display: flex;
  gap: 12px;
}

.brand-lockup {
  margin-bottom: 32px;
}

.brand-lockup--compact {
  margin-bottom: 0;
}

.brand-lockup img {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 8px;
  box-shadow: 0 12px 32px rgba(6, 42, 58, 0.2);
  display: block;
  height: 56px;
  object-fit: contain;
  padding: 7px;
  width: 56px;
}

.brand-lockup--compact img {
  height: 46px;
  width: 46px;
}

.brand-lockup strong,
.brand-lockup span,
.topbar__identity strong,
.topbar__identity span {
  display: block;
}

.brand-lockup strong {
  color: inherit;
  font-size: 17px;
  font-weight: 850;
  line-height: 1.15;
}

.brand-lockup span,
.topbar__identity span {
  color: var(--myc-soft-text);
  font-size: 13.5px;
  font-weight: 750;
  margin-top: 2px;
}

.sidebar .brand-lockup {
  color: #ffffff;
}

.sidebar .brand-lockup span {
  color: rgba(226, 241, 241, 0.72);
}

.loading-screen .brand-lockup {
  margin-bottom: 0;
}

.loading-screen .brand-lockup span {
  color: rgba(255, 255, 255, 0.72);
}

.auth-heading {
  margin-bottom: 24px;
}

.auth-heading p,
.workspace-header p {
  color: var(--myc-primary);
  font-size: 13.5px;
  font-weight: 800;
  letter-spacing: 0;
  margin: 0 0 7px;
  text-transform: uppercase;
}

.auth-heading h1,
.workspace-header h1 {
  color: var(--myc-navy);
  font-size: clamp(30px, 4vw, 42px);
  font-weight: 850;
  line-height: 1.16;
  color: #eaf4f2;
  margin: 0;
}

.auth-form {
  display: grid;
  gap: 14px;
}

.auth-form label {
  color: #eceded;
  display: grid;
  font-size: 14px;
  font-weight: 750;
  gap: 7px;
}

.auth-form input {
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(15, 118, 110, 0.22);
  border-radius: 6px;
  color: var(--myc-text);
  min-height: 42px;
  outline: none;
  padding: 0 12px;
}

.auth-form input:focus {
  border-color: var(--myc-primary);
  box-shadow: 0 0 0 3px rgba(53, 208, 186, 0.18);
}

.primary-button,
.icon-text-button,
.text-button,
.nav-item,
.module-card {
  border: 0;
  border-radius: 6px;
}

.primary-button {
  align-items: center;
  background: linear-gradient(135deg, var(--myc-primary), #099d91);
  color: #ffffff;
  display: inline-flex;
  font-weight: 800;
  justify-content: center;
  min-height: 42px;
  padding: 0 18px;
}

.primary-button:hover {
  background: linear-gradient(135deg, #0b625c, var(--myc-primary));
}

.primary-button:disabled {
  background: #7aa9a4;
  cursor: not-allowed;
}

.text-button {
  background: transparent;
  color: var(--myc-primary);
  font-weight: 800;
  margin-top: 16px;
  padding: 8px 0;
}

.form-error {
  background: rgba(254, 242, 242, 0.9);
  border: 1px solid #fecaca;
  border-radius: 6px;
  color: #991b1b;
  font-size: 14px;
  font-weight: 700;
  padding: 10px 12px;
}

.form-notice {
  background: rgba(236, 253, 245, 0.9);
  border: 1px solid rgba(45, 212, 191, 0.34);
  border-radius: 6px;
  color: #065f46;
  font-size: 14px;
  font-weight: 800;
  padding: 10px 12px;
}

.capture-processing-result {
  display: grid;
  gap: 12px;
  margin: 14px 0;
  padding: 16px;
  border: 1px solid rgba(8, 117, 111, 0.24);
  border-radius: 12px;
  background: rgba(236, 253, 245, 0.72);
  color: #134e4a;
}

.capture-processing-result p,
.capture-processing-result h4 {
  margin: 0;
}

.capture-processing-result__metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.capture-processing-result__metrics span {
  padding: 6px 9px;
  border: 1px solid rgba(8, 117, 111, 0.18);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.72);
  font-size: 12px;
}

.capture-processing-result__issues ul {
  margin: 8px 0 0;
  padding-left: 20px;
}

.capture-processing-result__clean {
  color: #047857;
  font-weight: 700;
}

.dashboard-error {
  margin-bottom: 18px;
}

.app-shell {
  display: grid;
  isolation: isolate;
  position: relative;
}

.app-shell--dashboard {
  grid-template-columns: minmax(0, 1fr);
}

.app-shell--dashboard .workspace {
  margin: 0 auto;
  max-width: 1480px;
  width: 100%;
}

.app-shell--module {
  grid-template-columns: 280px minmax(0, 1fr);
  transition: grid-template-columns 180ms ease;
}

.app-shell--module.is-sidebar-collapsed {
  grid-template-columns: 86px minmax(0, 1fr);
}

.sidebar {
  backdrop-filter: blur(22px) saturate(132%);
  background: rgba(5, 31, 45, 0.72);
  border-right: 1px solid rgba(201, 255, 247, 0.22);
  color: #f7fafc;
  min-height: 100vh;
  padding: 24px;
  position: relative;
  transition:
    padding 180ms ease,
    transform 220ms ease,
    width 180ms ease;
  z-index: 20;
}

.sidebar__controls {
  align-items: center;
  display: flex;
  gap: 8px;
  justify-content: flex-end;
  margin-bottom: 14px;
}

.sidebar-collapse-button,
.sidebar-mobile-close,
.sidebar-menu-button {
  align-items: center;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(201, 255, 247, 0.24);
  color: #f7fafc;
  display: inline-flex;
  justify-content: center;
  min-height: 36px;
  padding: 0;
  width: 36px;
}

.sidebar-collapse-button:hover,
.sidebar-mobile-close:hover,
.sidebar-menu-button:hover {
  background: rgba(70, 216, 196, 0.2);
  color: #ffffff;
}

.sidebar-mobile-close,
.sidebar-menu-button,
.sidebar-overlay {
  display: none;
}

.is-sidebar-collapsed .sidebar {
  padding: 18px 12px;
}

.is-sidebar-collapsed .sidebar__controls {
  justify-content: center;
}

.is-sidebar-collapsed .sidebar .brand-lockup {
  justify-content: center;
  margin-bottom: 18px;
}

.is-sidebar-collapsed .sidebar .brand-lockup div {
  display: none;
}

.is-sidebar-collapsed .sidebar .brand-lockup img {
  height: 48px;
  width: 48px;
}

.is-sidebar-collapsed .nav-item {
  justify-content: center;
  padding: 0;
}

.is-sidebar-collapsed .nav-item span {
  display: none;
}

.nav-list {
  display: grid;
  gap: 8px;
}

.lab-nav-list {
  border-top: 1px solid rgba(226, 241, 241, 0.18);
  display: grid;
  gap: 7px;
  margin-top: auto;
  padding-top: 16px;
}

.lab-nav-list > span {
  color: rgba(226, 241, 241, 0.58);
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.08em;
  padding: 0 10px;
  text-transform: uppercase;
}

.nav-item--lab {
  background: rgba(70, 216, 196, 0.11);
  border: 1px solid rgba(122, 249, 225, 0.17);
}

.nav-item {
  align-items: center;
  background: rgba(255, 255, 255, 0.07);
  color: rgba(235, 248, 248, 0.92);
  display: flex;
  gap: 10px;
  min-height: 42px;
  padding: 0 12px;
  text-align: left;
  font-size: 14.5px;
  font-weight: 750;
}

.nav-item:hover {
  background: rgba(53, 208, 186, 0.16);
  color: #ffffff;
}

.workspace {
  min-width: 0;
  padding: 24px 28px 32px;
}

.topbar {
  align-items: center;
  backdrop-filter: blur(22px) saturate(150%);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.5), rgba(222, 255, 250, 0.22)),
    rgba(255, 255, 255, 0.26);
  border: 1px solid var(--glass-border);
  border-radius: 8px;
  box-shadow: 0 16px 36px rgba(6, 42, 58, 0.09);
  display: flex;
  gap: 18px;
  justify-content: space-between;
  margin-bottom: 24px;
  min-height: 74px;
  overflow: hidden;
  padding: 12px 18px;
  position: relative;
}

.topbar::before,
.workspace-header__summary::before,
.operations-band::before,
.module-workspace__panel::before {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.78), rgba(70, 216, 196, 0.2), transparent);
  content: "";
  height: 1px;
  left: 16px;
  position: absolute;
  right: 16px;
  top: 10px;
}

.topbar__identity {
  color: var(--myc-text);
  margin-left: auto;
}

.topbar__identity strong {
  color: var(--myc-navy);
  font-size: 15px;
  font-weight: 850;
}

.topbar__identity > svg {
  color: var(--myc-primary);
}

.sidebar-menu-button {
  background: rgba(8, 117, 111, 0.9);
  border-color: rgba(201, 255, 247, 0.36);
  color: #ffffff;
  flex: 0 0 auto;
}

.icon-text-button {
  align-items: center;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(15, 118, 110, 0.18);
  color: #244253;
  display: inline-flex;
  font-weight: 800;
  gap: 8px;
  min-height: 38px;
  padding: 0 12px;
}

.icon-text-button:hover {
  background: #ffffff;
}

.workspace-header {
  align-items: flex-end;
  color: var(--myc-text);
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.workspace-header span {
  color: var(--myc-soft-text);
  display: block;
  font-size: 15px;
  font-weight: 750;
  line-height: 1.45;
  margin-top: 10px;
}

.workspace-header__welcome {
  backdrop-filter: blur(14px);
  background: rgba(255, 255, 255, 0.3);
  border: 1px solid rgba(201, 255, 247, 0.34);
  border-radius: 8px;
  color: var(--myc-navy) !important;
  display: inline-block !important;
  font-size: 16.5px !important;
  font-weight: 850 !important;
  line-height: 1.42 !important;
  padding: 7px 10px;
}

.workspace-header__summary {
  backdrop-filter: blur(18px) saturate(140%);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.46), rgba(70, 216, 196, 0.13)),
    var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: 8px;
  box-shadow: 0 14px 32px rgba(6, 42, 58, 0.08);
  min-width: 170px;
  padding: 14px 16px;
  position: relative;
  text-align: right;
}

.workspace-header__summary strong {
  color: var(--myc-primary-dark);
  display: block;
  font-size: 32px;
  line-height: 1;
}

.workspace-header__summary span {
  color: var(--myc-soft-text);
  font-size: 13.5px;
  font-weight: 800;
  margin-top: 6px;
}

.flow-strip {
  backdrop-filter: blur(18px) saturate(135%);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.36), rgba(70, 216, 196, 0.12)),
    rgba(255, 255, 255, 0.24);
  border: 1px solid var(--glass-border);
  border-radius: 8px;
  box-shadow: 0 14px 34px rgba(6, 42, 58, 0.08);
  display: grid;
  gap: 8px;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  margin-bottom: 22px;
  padding: 12px;
}

.flow-strip span {
  backdrop-filter: blur(18px);
  background: rgba(232, 248, 246, 0.34);
  border: 1px solid rgba(201, 255, 247, 0.42);
  border-radius: 6px;
  color: #074c49;
  font-size: 13.5px;
  font-weight: 800;
  min-height: 34px;
  padding: 8px;
  text-align: center;
}

.modules-grid {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-bottom: 22px;
}

.module-card {
  backdrop-filter: blur(18px) saturate(155%);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.42), rgba(70, 216, 196, 0.11) 46%, rgba(255, 255, 255, 0.18)),
    rgba(255, 255, 255, 0.24);
  border: 1px solid rgba(201, 255, 247, 0.56);
  box-shadow: var(--glass-shadow);
  color: var(--myc-text);
  display: grid;
  min-height: 214px;
  overflow: hidden;
  padding: 20px;
  position: relative;
  text-align: left;
  transition:
    border-color 180ms ease,
    box-shadow 180ms ease,
    transform 180ms ease;
}

.module-card::before {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.3), transparent 44%),
    linear-gradient(315deg, rgba(70, 216, 196, 0.14), transparent 36%);
  content: "";
  inset: 1px;
  pointer-events: none;
  position: absolute;
}

.module-card::after {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.22), transparent),
    linear-gradient(145deg, rgba(255, 255, 255, 0.2), rgba(234, 250, 248, 0.18));
  content: "";
  height: 54px;
  left: 0;
  pointer-events: none;
  position: absolute;
  right: 0;
  top: 0;
}

.module-card:hover {
  border-color: rgba(70, 216, 196, 0.72);
  box-shadow: 0 30px 82px rgba(5, 31, 45, 0.24);
  transform: translateY(-2px);
}

.module-card__header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
  position: relative;
  z-index: 1;
}

.module-card__icon {
  align-items: center;
  background: linear-gradient(135deg, rgba(15, 118, 110, 0.96), rgba(53, 208, 186, 0.9));
  border-radius: 8px;
  box-shadow: 0 14px 30px rgba(15, 118, 110, 0.22);
  color: #ffffff;
  display: inline-flex;
  height: 48px;
  justify-content: center;
  width: 48px;
}

.module-card__status {
  background: rgba(232, 250, 247, 0.62);
  border: 1px solid rgba(8, 117, 111, 0.22);
  border-radius: 999px;
  color: #074c49;
  font-size: 12px;
  font-weight: 850;
  padding: 5px 9px;
  white-space: nowrap;
}

.status-pendiente {
  background: rgba(235, 241, 245, 0.66);
  border-color: rgba(55, 80, 99, 0.22);
  color: #253d4f;
}

.status-en-desarrollo {
  background: rgba(229, 249, 250, 0.66);
  border-color: rgba(24, 117, 129, 0.24);
  color: #0b5d67;
}

.module-card h2 {
  color: var(--myc-primary);
  font-size: 22px;
  font-weight: 850;
  line-height: 1.2;
  margin: 0 0 10px;
  position: relative;
  z-index: 1;
}
.dashboard-control-panel__header h2,
.dashboard-section-heading h2 {
  color: var(--dashboard-title-color);
  font-size: 20px;
  line-height: 1.12;
  margin: 0;
}

.module-card p {
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 8px;
  color: var(--myc-soft-text);
  font-size: 15px;
  font-weight: 650;
  line-height: 1.5;
  margin: 0 0 22px;
  padding: 10px 11px;
  position: relative;
  z-index: 1;
}

.module-card__footer {
  align-items: baseline;
  border-top: 1px solid rgba(15, 118, 110, 0.12);
  display: flex;
  gap: 8px;
  margin-top: auto;
  min-height: 52px;
  padding-top: 14px;
  position: relative;
  z-index: 1;
}

.module-card__footer strong {
  color: var(--myc-primary-dark);
  font-size: 32px;
  font-weight: 850;
  line-height: 1;
}

.module-card__footer span {
  color: var(--myc-soft-text);
  font-size: 13.5px;
  font-weight: 800;
}

.operations-band {
  backdrop-filter: blur(18px) saturate(145%);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.34), rgba(70, 216, 196, 0.12)),
    rgba(255, 255, 255, 0.2);
  border: 1px solid var(--glass-border);
  border-radius: 8px;
  box-shadow: 0 16px 42px rgba(6, 42, 58, 0.08);
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  padding: 14px;
  position: relative;
}

.dashboard-control-panel,
.dashboard-section-block {
  backdrop-filter: blur(18px) saturate(145%);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.34), rgba(70, 216, 196, 0.12)),
    rgba(255, 255, 255, 0.2);
  border: 1px solid var(--glass-border);
  border-radius: 8px;
  box-shadow: 0 16px 42px rgba(6, 42, 58, 0.08);
  display: grid;
  gap: 14px;
  padding: 16px;
}

.dashboard-control-panel__header,
.dashboard-section-heading {
  align-items: end;
  display: flex;
  gap: 16px;
  justify-content: space-between;
}

.dashboard-control-panel__header p,
.dashboard-section-heading p {
  color: var(--myc-primary);
  font-size: 12px;
  font-weight: 850;
  margin: 0 0 4px;
  text-transform: uppercase;
}

.dashboard-control-panel__header h2,
.dashboard-section-heading h2 {
  color: var(--dashboard-title-color);
  font-size: 20px;
  line-height: 1.12;
  margin: 0;
}

.dashboard-progress-summary {
  align-items: flex-end;
  display: grid;
  justify-items: end;
}

.dashboard-progress-summary strong {
  color: var(--myc-primary-dark);
  font-size: 34px;
  line-height: 1;
}

.dashboard-progress-summary span {
  color: var(--myc-soft-text);
  font-size: 12px;
  font-weight: 850;
}

.dashboard-progress-bar {
  background: rgba(5, 31, 45, 0.08);
  border-radius: 999px;
  height: 10px;
  overflow: hidden;
}

.dashboard-progress-bar span {
  background: linear-gradient(90deg, var(--myc-primary), #46d8c4);
  display: block;
  height: 100%;
}

.dashboard-executive-grid {
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.dashboard-executive-grid--compact {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}

.operations-band__metric {
  backdrop-filter: blur(18px);
  background: rgba(255, 255, 255, 0.28);
  border: 1px solid rgba(201, 255, 247, 0.36);
  border-radius: 8px;
  justify-content: space-between;
  min-height: 76px;
  padding: 14px;
}

.module-workspace {
  display: grid;
  gap: 20px;
}

.module-workspace__hero,
.module-workspace__panel {
  backdrop-filter: blur(18px) saturate(145%);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.42), rgba(70, 216, 196, 0.12)),
    rgba(255, 255, 255, 0.24);
  border: 1px solid var(--glass-border);
  border-radius: 8px;
  box-shadow: var(--glass-shadow);
  overflow: hidden;
  position: relative;
}

.module-workspace__hero {
  align-items: center;
  display: flex;
  gap: 18px;
  min-height: 180px;
  padding: 28px;
}

.module-workspace__icon {
  align-items: center;
  background: linear-gradient(135deg, var(--myc-primary), var(--myc-accent));
  border-radius: 8px;
  color: #ffffff;
  display: inline-flex;
  height: 62px;
  justify-content: center;
  width: 62px;
}

.module-workspace__hero p {
  color: var(--myc-primary);
  font-size: 13.5px;
  font-weight: 850;
  margin: 0 0 7px;
  text-transform: uppercase;
}

.module-workspace__hero h1 {
  color: var(--myc-navy);
  font-size: clamp(30px, 4vw, 44px);
  font-weight: 850;
  line-height: 1.16;
  margin: 0;
}

.module-workspace__hero span {
  color: var(--myc-soft-text);
  display: block;
  font-size: 15px;
  font-weight: 750;
  line-height: 1.45;
  margin-top: 10px;
}

.module-workspace__time {
  backdrop-filter: blur(18px);
  background: rgba(255, 255, 255, 0.28);
  border: 1px solid rgba(201, 255, 247, 0.42);
  border-radius: 8px;
  color: var(--myc-primary-dark);
  font-size: 14.5px;
  font-weight: 850;
  margin-left: auto;
  min-width: 190px;
  padding: 12px 14px;
  text-align: right;
}

.module-workspace__panel {
  padding: 22px;
}

.module-workspace__panel h2 {
  color: var(--myc-navy);
  font-size: 20px;
  font-weight: 850;
  margin: 0 0 8px;
}

.module-workspace__panel p {
  color: var(--myc-soft-text);
  font-size: 15px;
  font-weight: 650;
  line-height: 1.55;
  margin: 0;
  max-width: 720px;
}

.clients-workspace {
  gap: 18px;
}

.clients-hero {
  min-height: 150px;
}

.clients-list-panel {
  backdrop-filter: blur(18px) saturate(145%);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.44), rgba(70, 216, 196, 0.12)),
    rgba(255, 255, 255, 0.24);
  border: 1px solid var(--glass-border);
  border-radius: 8px;
  box-shadow: var(--glass-shadow);
  overflow: hidden;
  padding: 20px;
  position: relative;
}

.clients-list-panel::before {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.78), rgba(70, 216, 196, 0.22), transparent);
  content: "";
  height: 1px;
  left: 16px;
  position: absolute;
  right: 16px;
  top: 10px;
}

.section-heading {
  align-items: flex-start;
  display: flex;
  gap: 16px;
  justify-content: space-between;
  margin-bottom: 16px;
}

.section-heading p {
  color: var(--myc-primary);
  font-size: 13.5px;
  font-weight: 850;
  margin: 0 0 5px;
  text-transform: uppercase;
}

.section-heading h2 {
  color: var(--myc-navy);
  font-size: 22px;
  font-weight: 850;
  line-height: 1.2;
  margin: 0;
}

.client-form {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.client-form label {
  color: var(--myc-soft-text);
  display: grid;
  font-size: 14px;
  font-weight: 800;
  gap: 7px;
  min-width: 0;
  min-inline-size: 0;
}

.client-tax-regime-select {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.client-form input,
.client-form select,
.client-form textarea {
  background: rgba(255, 255, 255, 0.58);
  border: 1px solid rgba(8, 117, 111, 0.18);
  border-radius: 6px;
  color: var(--myc-navy);
  outline: none;
  padding: 0 12px;

  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-inline-size: 0;
  box-sizing: border-box;
}

.client-form input,
.client-form select {
  min-height: 42px;
}

.client-form textarea {
  min-height: 96px;
  padding: 10px 12px;
  resize: vertical;
}

.client-form input:focus,
.client-form select:focus,
.client-form textarea:focus {
  border-color: var(--myc-primary);
  box-shadow: 0 0 0 3px rgba(70, 216, 196, 0.18);
}

.client-form input[aria-invalid="true"] {
  border-color: #dc2626;
  box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12);
}

.client-form input:disabled,
.client-form select:disabled {
  color: #607482;
  cursor: not-allowed;
  opacity: 0.8;
}

.field-error {
  color: #991b1b;
  font-size: 12.5px;
  font-weight: 800;
  line-height: 1.35;
}

.client-form__actions {
  align-items: end;
  display: flex;
}

.modal-backdrop {
  align-items: center;
  background:
    linear-gradient(135deg, rgba(5, 31, 45, 0.58), rgba(5, 53, 66, 0.4)),
    rgba(5, 31, 45, 0.42);
  backdrop-filter: blur(10px);
  display: flex;
  inset: 0;
  justify-content: center;
  padding: 22px;
  position: fixed;
  z-index: 20;
}

.client-modal {
  backdrop-filter: blur(22px) saturate(150%);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.56), rgba(70, 216, 196, 0.16)),
    rgba(255, 255, 255, 0.36);
  border: 1px solid rgba(201, 255, 247, 0.62);
  border-radius: 8px;
  box-shadow: 0 34px 90px rgba(5, 31, 45, 0.32);
  max-height: min(720px, calc(100vh - 44px));
  max-width: 780px;
  overflow: auto;
  padding: 22px;
  position: relative;
  width: min(780px, 100%);
}

.client-modal::before {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.86), rgba(70, 216, 196, 0.24), transparent);
  content: "";
  height: 1px;
  left: 16px;
  position: absolute;
  right: 16px;
  top: 10px;
}

.client-modal-tabs {
  backdrop-filter: blur(16px);
  background: rgba(255, 255, 255, 0.26);
  border: 1px solid rgba(201, 255, 247, 0.38);
  border-radius: 8px;
  display: grid;
  gap: 6px;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-bottom: 16px;
  padding: 6px;
  position: sticky;
  top: 0;
  z-index: 2;
}

.client-certificate-profiles {
  display: grid;
  gap: 14px;
  grid-column: 1 / -1;
}

.client-certificate-profiles__intro,
.client-certificate-profile {
  align-items: flex-start;
  display: flex;
  gap: 14px;
  justify-content: space-between;
}

.client-certificate-profiles__intro h3,
.client-certificate-profiles__intro p,
.client-certificate-profile p {
  margin: 0;
}

.client-certificate-profiles__intro p {
  color: #607482;
  font-size: 13px;
  margin-top: 4px;
}

.client-certificate-profile-list {
  display: grid;
  gap: 8px;
}

.client-certificate-profile {
  background: rgba(255, 255, 255, 0.36);
  border: 1px solid rgba(8, 117, 111, 0.15);
  border-radius: 7px;
  padding: 11px 12px;
}

.client-certificate-profile.is-active {
  border-color: var(--myc-primary);
}

.client-certificate-profile > div:first-child {
  display: grid;
  gap: 3px;
}

.client-certificate-profile > div:last-child {
  display: flex;
  gap: 6px;
}

.client-certificate-profile strong {
  color: var(--myc-navy);
}

.client-certificate-profile span {
  background: rgba(70, 216, 196, 0.22);
  border-radius: 999px;
  color: #075e59;
  font-size: 10px;
  font-weight: 850;
  padding: 3px 7px;
  width: fit-content;
}

.client-certificate-profile small {
  color: #607482;
}

.client-certificate-profile-editor {
  background: rgba(255, 255, 255, 0.3);
  border-radius: 8px;
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding: 14px;
}

.client-certificate-profile-editor__actions {
  display: flex;
  gap: 8px;
  justify-content: flex-end;
}

@media (max-width: 720px) {
  .client-modal-tabs,
.client-certificate-profile-editor {
    grid-template-columns: 1fr;
  }
}

.client-modal-tab {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 6px;
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 850;
  min-height: 38px;
  padding: 0 10px;
}

.client-modal-tab.is-active {
  background: rgba(232, 250, 247, 0.76);
  border-color: rgba(8, 117, 111, 0.2);
  color: var(--myc-primary-dark);
  box-shadow: 0 10px 24px rgba(5, 31, 45, 0.08);
}

.client-modal-tab:disabled,
.icon-text-button:disabled,
.table-button:disabled {
  cursor: not-allowed;
  opacity: 0.62;
}

.client-form--modal {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

#catalog-item-form > label,
#catalog-item-form > div {
  min-width: 0;
  min-inline-size: 0;
}

#catalog-item-form input,
#catalog-item-form select,
#catalog-item-form textarea {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-inline-size: 0;
  box-sizing: border-box;
}

.client-form__actions--modal {
  gap: 10px;
  grid-column: 1 / -1;
  justify-content: flex-end;
}

.form-field--wide {
  grid-column: 1 / -1;
}

.client-form__visual-actions {
  align-items: end;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.client-fiscal-layout {
  align-items: start;
  display: grid;
  gap: 24px;
  grid-column: 1 / -1;
  grid-template-columns: minmax(0, 1.35fr) minmax(220px, 0.85fr);
}

.client-fiscal-fields {
  display: grid;
  gap: 14px;
  min-width: 0;
}

.client-fiscal-fields > .invoice-sat-field,
.client-fiscal-fields .invoice-sat-field__value {
  box-sizing: border-box;
  max-width: 100%;
  min-width: 0;
  width: 100%;
}

.client-fiscal-support {
  min-width: 0;
  padding-top: 310px;
}

.client-fiscal-support .client-form__visual-actions {
  align-items: stretch;
  flex-direction: column;
}

.client-fiscal-support .client-file-indicator,
.client-fiscal-support .table-button,
.client-fiscal-support .icon-text-button {
  max-width: 100%;
}

@media (max-width: 720px) {
  .client-fiscal-layout {
    gap: 14px;
    grid-template-columns: 1fr;
  }

  .client-fiscal-support {
    padding-top: 0;
  }
}

.client-fiscal-note {
  align-self: end;
  background: rgba(255, 255, 255, 0.28);
  border: 1px solid rgba(201, 255, 247, 0.34);
  border-radius: 8px;
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 800;
  line-height: 1.45;
  padding: 10px 12px;
}

.clients-table {
  display: grid;
  gap: 8px;
}

.clients-table__head,
.clients-table__row {
  display: grid;
  gap: 10px;
  grid-template-columns: 42px 1.35fr 0.8fr 1fr 0.9fr 1.25fr 0.72fr;
}

.clients-table__head {
  color: var(--myc-primary-dark);
  font-size: 12.5px;
  font-weight: 850;
  padding: 0 10px 4px;
  text-transform: uppercase;
}

.clients-table__row {
  align-items: center;
  backdrop-filter: blur(14px);
  background: rgba(255, 255, 255, 0.28);
  border: 1px solid rgba(201, 255, 247, 0.34);
  border-radius: 8px;
  color: var(--myc-soft-text);
  font-size: 14px;
  font-weight: 700;
  min-height: 58px;
  padding: 10px;
}

.clients-filters {
  display: grid;
  gap: 12px;
  grid-template-columns: minmax(0, 1.6fr) minmax(220px, 0.7fr);
  margin: 0 0 14px;
}

.clients-table__row--clickable {
  cursor: pointer;
}

.clients-table__row--clickable:hover,
.clients-table__row--clickable:focus-visible {
  background: rgba(232, 250, 247, 0.72);
  border-color: rgba(8, 117, 111, 0.36);
  outline: none;
}

.quality-action-ribbon {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 16px 0;
}

.match-details-panel {
  max-height: 180px;
  overflow: auto;
  padding: 12px;
  border: 1px solid rgba(8, 117, 111, 0.18);
  border-radius: 8px;
  background: rgba(248, 250, 252, 0.92);
  font-size: 12px;
  white-space: pre-wrap;
}

.quotation-row-button:hover,
.quotation-row-button:focus-visible {
  background: rgba(232, 250, 247, 0.72);
  border-color: rgba(8, 117, 111, 0.36);
  box-shadow: 0 14px 30px rgba(5, 31, 45, 0.1);
  outline: none;
}

.clients-table__row > span {
  overflow-wrap: anywhere;
}

.client-row-meta,
.client-row-alert {
  display: block;
  font-size: 11px;
  font-weight: 700;
  margin-top: 3px;
}

.client-row-meta {
  color: rgba(12, 74, 71, 0.72);
}

.client-row-alert {
  color: #a16207;
}

.quotations-table .clients-table__head,
.quotations-table .clients-table__row {
  grid-template-columns: 0.9fr 1.35fr 0.72fr 0.95fr 0.95fr 0.82fr 0.85fr;
}

.products-table .clients-table__head,
.products-table .clients-table__row {
  grid-template-columns: 0.62fr 0.9fr 0.8fr 1.45fr 0.82fr 1fr 1fr 0.7fr 0.88fr;
}

.clients-table__row--clickable {
  cursor: pointer;
}

.clients-table__row--clickable:hover {
  border-color: rgba(8, 117, 111, 0.28);
  transform: translateY(-1px);
}

.service-orders-table .clients-table__head,
.service-orders-table .clients-table__row {
  grid-template-columns: .9fr .65fr 1.05fr .9fr 1fr .8fr .55fr .55fr .55fr .55fr .6fr .6fr .65fr;
}

.equipment-table .clients-table__head,
.equipment-table .clients-table__row {
  grid-template-columns: 1fr .75fr .75fr .85fr .85fr .85fr .95fr .8fr .75fr .9fr .75fr 1.7fr;
}

.ets-expedient-search {
  background: rgba(255, 255, 255, 0.34);
  border: 1px solid rgba(201, 255, 247, 0.44);
  border-radius: 8px;
  display: grid;
  gap: 7px;
  margin: -4px 0 12px;
  padding: 10px 12px;
}

.ets-expedient-search span {
  color: var(--myc-soft-text);
  font-size: 12px;
  font-weight: 850;
  text-transform: uppercase;
}

.ets-expedient-search input {
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(8, 117, 111, 0.18);
  border-radius: 8px;
  color: var(--myc-text);
  font-size: 14px;
  font-weight: 780;
  min-height: 40px;
  padding: 0 12px;
}

.ets-modal-action-ribbon {
  align-items: center;
  background: rgba(255, 255, 255, 0.34);
  border: 1px solid rgba(201, 255, 247, 0.44);
  border-radius: 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: -6px 0 16px;
  padding: 10px;
}

.ets-admin-actions {
  position: relative;
}

.ets-admin-actions__menu {
  background: #fff;
  border: 1px solid rgba(15, 23, 42, 0.12);
  border-radius: 8px;
  box-shadow: 0 16px 32px rgba(15, 23, 42, 0.16);
  display: grid;
  gap: 2px;
  min-width: 180px;
  padding: 6px;
  position: absolute;
  right: 0;
  top: calc(100% + 6px);
  z-index: 20;
}

.ets-admin-actions__menu button {
  background: transparent;
  border: 0;
  border-radius: 6px;
  color: var(--myc-text);
  cursor: pointer;
  font: inherit;
  font-size: 13px;
  font-weight: 800;
  padding: 9px 10px;
  text-align: left;
}

.ets-admin-actions__menu button:hover:not(:disabled) {
  background: rgba(8, 117, 111, 0.08);
}

.ets-admin-actions__menu button:disabled {
  color: var(--myc-soft-text);
  cursor: not-allowed;
}

.ets-admin-actions__menu .is-danger {
  color: #b42318;
}

.ets-certificates-table .clients-table__head,
.ets-certificates-table .clients-table__row {
  grid-template-columns: .9fr 1fr .8fr .85fr .8fr .75fr 1.9fr;
}

.ets-certificates-table .clients-table__head:has(span:nth-child(10)),
.ets-certificates-table .clients-table__row:has(span:nth-child(10)) {
  grid-template-columns: .85fr .9fr .75fr .8fr .85fr .75fr .7fr .65fr .9fr 1.6fr;
}

.ets-certificates-table .clients-table__head:has(span:nth-child(12)),
.ets-certificates-table .clients-table__row:has(span:nth-child(12)) {
  grid-template-columns: .85fr .85fr .7fr .75fr .8fr .75fr .75fr .85fr .65fr .65fr .9fr 2fr;
}

.ets-folder-tabs {
  align-items: end;
  display: flex;
  gap: 4px;
  margin: 0 0 18px;
  overflow-x: auto;
  padding: 8px 4px 0;
}

.ets-folder-tab {
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.34);
  border: 1px solid rgba(201, 255, 247, 0.5);
  border-bottom-color: rgba(8, 117, 111, 0.18);
  border-radius: 8px 8px 0 0;
  color: var(--myc-soft-text);
  display: inline-flex;
  flex-direction: column;
  flex: 0 0 auto;
  font-size: 13px;
  font-weight: 850;
  gap: 4px;
  min-height: 42px;
  justify-content: center;
  padding: 7px 14px;
}

.ets-folder-tab.is-active {
  background: rgba(232, 250, 247, 0.94);
  border-color: rgba(8, 117, 111, 0.3);
  border-bottom-color: rgba(232, 250, 247, 0.94);
  color: var(--myc-primary-dark);
  min-height: 50px;
  transform: translateY(1px);
}

.ets-stage-badge,
.ets-inline-stage {
  border-radius: 999px;
  display: inline-flex;
  font-size: 10px;
  font-weight: 900;
  line-height: 1;
  padding: 5px 7px;
  text-transform: uppercase;
}

.ets-stage-badge.is-done,
.ets-inline-stage.is-done,
.ets-stage.is-done {
  background: rgba(70, 216, 196, 0.18);
  border-color: rgba(8, 117, 111, 0.28);
  color: var(--myc-primary-dark);
}

.ets-stage-badge.is-active,
.ets-inline-stage.is-active,
.ets-stage.is-active {
  background: rgba(219, 234, 254, 0.86);
  color: #1d4ed8;
}

.ets-stage-badge.is-pending,
.ets-inline-stage.is-pending,
.ets-stage.is-pending {
  background: rgba(255, 255, 255, 0.62);
  color: var(--myc-soft-text);
}

.ets-stage-badge.is-blocked,
.ets-inline-stage.is-blocked,
.ets-stage.is-blocked {
  background: rgba(254, 242, 242, 0.82);
  color: #991b1b;
}

.ets-stage-badge.is-reopened,
.ets-inline-stage.is-reopened,
.ets-stage.is-reopened {
  background: rgba(254, 249, 195, 0.9);
  color: #92400e;
}

.ets-progress-panel,
.ets-auth-panel {
  background: rgba(255, 255, 255, 0.32);
  border: 1px solid rgba(201, 255, 247, 0.42);
  border-radius: 8px;
  display: grid;
  gap: 12px;
  margin-bottom: 16px;
  padding: 14px;
}

.ets-progress-panel__header {
  align-items: baseline;
  display: flex;
  gap: 10px;
}

.ets-progress-panel__header strong {
  color: var(--myc-primary-dark);
  font-size: 28px;
  line-height: 1;
}

.ets-progress-panel__header span,
.ets-auth-panel span {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.ets-progress-bar {
  background: rgba(5, 31, 45, 0.08);
  border-radius: 999px;
  height: 10px;
  overflow: hidden;
}

.ets-progress-bar span {
  background: linear-gradient(90deg, var(--myc-primary), #46d8c4);
  display: block;
  height: 100%;
}

.ets-stage-strip,
.ets-metric-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.ets-stage,
.ets-metric-badge {
  align-items: center;
  background: rgba(255, 255, 255, 0.42);
  border: 1px solid rgba(201, 255, 247, 0.42);
  border-radius: 999px;
  color: var(--myc-soft-text);
  display: inline-flex;
  font-size: 12px;
  font-weight: 850;
  gap: 6px;
  min-height: 30px;
  padding: 0 10px;
}

.ets-metric-badge strong {
  color: var(--myc-primary-dark);
}

.ets-summary-card,
.ets-summary-link {
  background: transparent;
  border: 0;
  color: inherit;
  cursor: pointer;
  font: inherit;
  padding: 0;
  text-align: left;
}

.ets-summary-card {
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.42);
  border: 1px solid rgba(201, 255, 247, 0.42);
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-height: 78px;
  padding: 14px;
}

.ets-summary-card:hover,
.ets-summary-card:focus-visible,
.ets-summary-link:hover,
.ets-summary-link:focus-visible {
  border-color: rgba(22, 148, 140, 0.5);
  box-shadow: 0 12px 24px rgba(9, 44, 54, 0.12);
  outline: none;
  transform: translateY(-1px);
}

.ets-summary-card span,
.ets-summary-link span,
.ets-summary-link small {
  color: var(--myc-soft-text);
  font-size: 12px;
  font-weight: 820;
}

.ets-summary-card strong,
.ets-summary-link strong {
  color: var(--myc-navy);
}

.ets-summary-card--clickable,
.ets-technician-card,
.ets-summary-work-orders {
  align-items: flex-start;
}

.ets-summary-card--clickable .table-button,
.ets-technician-card .table-button {
  margin-top: 8px;
}

.ets-summary-work-orders {
  cursor: pointer;
  justify-content: center;
  min-height: 120px;
  transition:
    transform .18s ease,
    border-color .18s ease,
    box-shadow .18s ease;
}

.ets-summary-work-orders span {
  color: var(--myc-soft-text);
  font-size: 12px;
  font-weight: 850;
  text-transform: uppercase;
}

.ets-summary-work-orders strong {
  color: var(--myc-primary-dark);
  font-size: 26px;
  line-height: 1;
}

.ets-summary-work-orders small {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 760;
}

.ets-summary-work-orders:hover {
  transform: translateY(-2px);
}

.ets-summary-link {
  align-items: center;
  background: rgba(255, 255, 255, 0.44);
  border: 1px solid rgba(201, 255, 247, 0.38);
  border-radius: 8px;
  display: flex;
  justify-content: space-between;
  min-height: 38px;
  padding: 8px 10px;
}

.ets-stage-note {
  background: rgba(255, 255, 255, 0.34);
  border: 1px solid rgba(201, 255, 247, 0.42);
  border-radius: 8px;
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 800;
  margin: 0 0 12px;
  padding: 10px 12px;
}

.ets-metric-strip + .ets-stage-note {
  margin-top: 12px;
}

.ets-active-context {
  align-items: center;
  background: rgba(255, 255, 255, 0.4);
  border: 1px solid rgba(201, 255, 247, 0.42);
  border-radius: 8px;
  display: flex;
  gap: 10px;
  justify-content: space-between;
  margin: -4px 0 12px;
  padding: 10px 12px;
}

.ets-active-context span {
  color: var(--myc-primary-dark);
  font-size: 13px;
  font-weight: 900;
}

.ets-animated-list {
  transition: grid-template-rows .22s ease, gap .22s ease;
}

.ets-list-item {
  max-height: 420px;
  opacity: 1;
  overflow: hidden;
  transform: translateY(0) scale(1);
  transition:
    max-height .24s ease,
    margin .24s ease,
    opacity .22s ease,
    padding .22s ease,
    transform .22s ease,
    border-color .18s ease,
    box-shadow .18s ease;
}

.ets-list-item.is-exiting {
  max-height: 0;
  margin: 0;
  opacity: 0;
  padding-bottom: 0;
  padding-top: 0;
  pointer-events: none;
  transform: translateY(8px) scale(.98);
}

.ets-auth-panel {
  margin-top: 14px;
}

.ets-auth-panel p {
  color: var(--myc-primary);
  font-size: 12px;
  font-weight: 850;
  margin: 0 0 4px;
  text-transform: uppercase;
}

.ets-auth-panel strong {
  color: var(--myc-navy);
}

.ets-timeline {
  display: grid;
  gap: 10px;
}

.ets-timeline-item {
  border-left: 3px solid rgba(8, 117, 111, 0.32);
  display: grid;
  gap: 10px;
  grid-template-columns: 180px minmax(0, 1fr);
  padding: 8px 0 8px 14px;
}

.ets-timeline-item time {
  color: var(--myc-soft-text);
  font-size: 12px;
  font-weight: 850;
}

.ets-timeline-item strong {
  color: var(--myc-navy);
  display: block;
}

.ets-timeline-item span,
.ets-timeline-item p {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 750;
  margin: 2px 0 0;
}

.table-button--file {
  align-items: center;
  display: inline-flex;
  justify-content: center;
  min-height: 34px;
}

.table-button--file input {
  display: none;
}

.ets-filter-tabs {
  margin-bottom: 14px;
}

.certificates-table .clients-table__head,
.certificates-table .clients-table__row {
  grid-template-columns: 1.2fr 1.15fr .95fr 1fr .8fr .95fr .85fr .85fr .75fr;
}

.pending-certificates-table .clients-table__head,
.pending-certificates-table .clients-table__row {
  grid-template-columns: 1.25fr 1fr 1fr .6fr 1fr 1fr 1.1fr;
}

.quality-table .clients-table__head,
.quality-table .clients-table__row {
  grid-template-columns: 1.15fr 1.15fr 1fr 1fr .8fr .85fr .9fr;
}

.audit-log-table .clients-table__head,
.audit-log-table .clients-table__row {
  grid-template-columns: 1fr .95fr 1.1fr .8fr .8fr 2.2fr;
}

.certificates-summary {
  margin-bottom: 18px;
}

.flow-ets-groups,
.flow-work-order-groups,
.flow-work-order-group__content {
  display: grid;
  gap: 14px;
}

.flow-ets-group {
  background: rgba(255, 255, 255, .34);
  border: 1px solid rgba(8, 117, 111, .14);
  border-radius: 10px;
  overflow: hidden;
}

.flow-ets-group__header {
  align-items: center;
  background: rgba(8, 117, 111, .06);
  border-bottom: 1px solid rgba(8, 117, 111, .12);
  display: flex;
  justify-content: space-between;
  padding: 16px 18px;
}

.flow-ets-group__header span,
.flow-work-order-group summary span,
.flow-certificate-card__title span {
  color: var(--myc-soft-text);
  display: block;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.flow-ets-group__header h3 {
  color: var(--myc-navy);
  margin: 3px 0 0;
}

.flow-work-order-groups {
  padding: 14px;
}

.flow-work-order-group {
  border: 1px solid rgba(8, 117, 111, .14);
  border-radius: 8px;
  overflow: hidden;
}

.flow-work-order-group > summary {
  align-items: center;
  background: rgba(255, 255, 255, .56);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  list-style: none;
  padding: 13px 15px;
}

.flow-work-order-group > summary::-webkit-details-marker {
  display: none;
}

.flow-work-order-group > summary strong {
  color: var(--myc-navy);
  font-size: 17px;
}

.flow-work-order-group__summary {
  align-items: center;
  display: flex;
  gap: 10px;
}

.flow-work-order-group__content {
  border-top: 1px solid rgba(8, 117, 111, .1);
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  padding: 14px;
}

.flow-certificate-card {
  background: rgba(255, 255, 255, .72);
  border: 1px solid rgba(8, 117, 111, .13);
  border-radius: 8px;
  display: grid;
  gap: 12px;
  padding: 14px;
}

.flow-certificate-card--button,
.flow-certificate-card__primary {
  color: inherit;
  cursor: pointer;
  text-align: left;
  width: 100%;
}

.flow-certificate-card--button {
  transition: border-color .18s ease, transform .18s ease;
}

.flow-certificate-card--button:hover {
  border-color: var(--myc-primary);
  transform: translateY(-1px);
}

.flow-certificate-card__primary {
  background: transparent;
  border: 0;
  display: grid;
  gap: 12px;
  padding: 0;
}

.flow-certificate-card__title {
  align-items: flex-start;
  display: flex;
  gap: 10px;
  justify-content: space-between;
}

.flow-certificate-card__title strong {
  color: var(--myc-primary-dark);
  display: block;
  font-size: 16px;
  margin-top: 3px;
}

.flow-certificate-card dl {
  display: grid;
  gap: 9px 14px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin: 0;
}

.flow-certificate-card dt {
  color: var(--myc-soft-text);
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
}

.flow-certificate-card dd {
  color: var(--myc-text);
  font-size: 13px;
  font-weight: 750;
  margin: 2px 0 0;
  overflow-wrap: anywhere;
}

.flow-primary-hint,
.flow-action-complete {
  align-items: center;
  color: var(--myc-primary-dark);
  display: inline-flex;
  font-size: 12px;
  font-weight: 900;
  gap: 6px;
}

.flow-release-blocked {
  background: rgba(180, 83, 9, .08);
  border: 1px solid rgba(180, 83, 9, .18);
  border-radius: 6px;
  color: #92400e;
  font-size: 12px;
  font-weight: 750;
  padding: 9px 10px;
}

.flow-release-ready {
  background: rgba(11, 122, 117, .08);
  border: 1px solid rgba(11, 122, 117, .18);
  border-radius: 6px;
  color: var(--myc-primary-dark);
  font-size: 12px;
  font-weight: 750;
  padding: 9px 10px;
}

.certificate-hash {
  overflow-wrap: anywhere;
}

@media (max-width: 680px) {
  .flow-ets-group__header,
.flow-work-order-group > summary {
    align-items: flex-start;
    flex-direction: column;
    gap: 9px;
  }

  .flow-work-order-group__content,
.flow-certificate-card dl {
    grid-template-columns: 1fr;
  }
}

.certificate-folio,
.certificate-folio-heading {
  color: var(--myc-primary-dark);
  font-weight: 900;
  letter-spacing: 0;
}

.service-order-info-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.ets-billing-tab {
  display: grid;
  gap: 16px;
  min-height: 500px;
  transition: none;
}

.ets-billing-tab > .quotation-section__title {
  margin-bottom: 0;
}

.ets-billing-tab-slot,
.ets-billing-tab__context {
  min-height: 420px;
  transition: none;
}

.ets-billing-tab__context {
  display: grid;
  gap: 16px;
}

.ets-billing-tab__loading {
  align-content: center;
  color: var(--myc-muted);
  display: grid;
  gap: 12px;
  justify-items: center;
  min-height: 420px;
  text-align: center;
  transition: none;
}

.ets-billing-tab__loading svg {
  color: var(--myc-primary);
}

.ets-invoice-summary {
  background: rgba(255, 255, 255, 0.38);
  border: 1px solid rgba(201, 255, 247, 0.48);
  border-left: 4px solid var(--myc-primary);
  border-radius: 8px;
  display: grid;
  gap: 18px;
  padding: 18px;
}

.ets-invoice-summary.is-cancelled {
  border-left-color: var(--myc-danger);
}

.ets-invoice-summary__heading,
.ets-invoice-summary__actions {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.ets-invoice-summary__heading {
  gap: 12px;
}

.ets-invoice-summary__heading > div {
  display: grid;
  gap: 3px;
}

.ets-invoice-summary__heading span,
.ets-invoice-summary__details dt,
.ets-billing-next-phase span {
  color: var(--myc-muted);
  font-size: 12px;
  font-weight: 700;
}

.ets-invoice-summary__heading strong {
  color: var(--myc-navy);
  font-size: 18px;
}

.ets-invoice-summary__icon {
  align-items: center;
  background: rgba(26, 161, 145, 0.12);
  border-radius: 8px;
  color: var(--myc-primary-dark);
  display: inline-flex;
  justify-content: center;
  padding: 10px;
}

.ets-invoice-summary__details {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin: 0;
}

.ets-invoice-summary__details div {
  display: grid;
  gap: 4px;
}

.ets-invoice-summary__details .is-wide {
  grid-column: 1 / -1;
}

.ets-invoice-summary__details dd {
  color: var(--myc-navy);
  font-weight: 800;
  margin: 0;
  overflow-wrap: anywhere;
}

.ets-billing-next-phase {
  display: grid;
  gap: 10px;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
}

.ets-billing-next-phase article {
  background: rgba(255, 255, 255, 0.22);
  border: 1px dashed rgba(40, 109, 102, 0.3);
  border-radius: 8px;
  display: grid;
  gap: 4px;
  padding: 13px;
}

.invoice-billing-status.is-empty,
.invoice-billing-status.is-draft,
.invoice-billing-status.is-stamped,
.invoice-billing-status.is-cancelled {
  align-items: center;
  display: inline-flex;
  gap: 7px;
}

.invoice-billing-status.is-empty i,
.invoice-billing-status.is-draft i,
.invoice-billing-status.is-stamped i,
.invoice-billing-status.is-cancelled i {
  background: currentColor;
  border-radius: 999px;
  height: 7px;
  width: 7px;
}

.invoice-billing-status.is-draft {
  color: var(--myc-info);
}

.invoice-billing-status.is-stamped {
  color: var(--myc-success);
}

.invoice-billing-status.is-cancelled {
  color: var(--myc-danger);
}

@media (max-width: 680px) {
  .ets-billing-tab,
.ets-billing-tab-slot,
.ets-billing-tab__context,
.ets-billing-tab__loading {
    min-height: 620px;
  }

  .ets-invoice-summary__details {
    grid-template-columns: 1fr;
  }
}

.ets-work-order-equipment-groups {
  display: grid;
  gap: 16px;
}

.ets-work-order-folder-grid,
.ets-signature-grid {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
}

.ets-work-order-folder,
.ets-signature-card {
  background: rgba(255, 255, 255, 0.42);
  border: 1px solid rgba(201, 255, 247, 0.46);
  border-radius: 8px;
  display: grid;
  gap: 12px;
  padding: 14px;
}

.ets-work-order-folder span,
.ets-signature-card span {
  color: var(--myc-soft-text);
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
}

.ets-work-order-folder strong {
  color: var(--myc-navy);
  display: block;
  font-size: 20px;
  font-weight: 900;
  margin-top: 3px;
}

.ets-work-order-folder dl {
  display: grid;
  gap: 8px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 0;
}

.ets-work-order-folder dt {
  color: var(--myc-soft-text);
  font-size: 11px;
  font-weight: 800;
}

.ets-work-order-folder dd {
  color: var(--myc-text);
  font-size: 16px;
  font-weight: 900;
  margin: 0;
}

.ets-signature-card__header {
  align-items: center;
  display: flex;
  gap: 10px;
  justify-content: space-between;
}

.ets-signature-launcher {
  align-items: center;
  background:
    radial-gradient(circle at 12% 12%, rgba(255, 255, 255, 0.62), transparent 34%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.48), rgba(235, 255, 253, 0.22));
  border: 1px solid rgba(201, 255, 247, 0.64);
  border-radius: 14px;
  box-shadow:
    0 18px 42px rgba(8, 35, 48, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.65);
  display: flex;
  gap: 16px;
  justify-content: space-between;
  margin: 12px 0 16px;
  overflow: hidden;
  padding: 14px 16px;
  position: relative;
}

.ets-signature-launcher::before {
  background: linear-gradient(90deg, rgba(12, 171, 164, 0.44), rgba(53, 242, 230, 0.08));
  content: "";
  inset: 0 auto 0 0;
  position: absolute;
  width: 3px;
}

.ets-signature-launcher__copy {
  display: grid;
  gap: 4px;
  min-width: 0;
}

.ets-signature-launcher__copy span {
  color: var(--myc-primary-dark);
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
}

.ets-signature-launcher__copy strong {
  color: var(--myc-navy);
  font-size: 16px;
  font-weight: 900;
}

.ets-signature-flow-modal {
  max-width: 980px;
}

.ets-signature-flow {
  display: grid;
  gap: 16px;
}

.ets-signature-flow__header {
  align-items: flex-start;
  display: flex;
  gap: 16px;
  justify-content: space-between;
}

.ets-signature-flow__header p,
.ets-signature-flow__header h3 {
  margin: 0;
}

.ets-signature-flow__header p {
  color: var(--myc-primary-dark);
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
}

.ets-signature-flow__header h3 {
  color: var(--myc-navy);
  font-size: 24px;
  font-weight: 900;
}

.ets-signature-flow__header span {
  color: var(--myc-soft-text);
  display: block;
  font-size: 13px;
  margin-top: 4px;
}

.ets-signature-card__header strong {
  color: var(--myc-text);
  display: block;
  font-size: 13px;
  margin-top: 3px;
}

.ets-signature-canvas {
  background: #fff;
  border: 1px dashed rgba(15, 23, 42, 0.28);
  border-radius: 8px;
  height: 120px;
  touch-action: none;
  width: 100%;
}

.ets-signature-preview {
  border: 1px solid rgba(15, 23, 42, 0.08);
  border-radius: 6px;
  max-height: 54px;
  object-fit: contain;
  width: 100%;
}

.ets-work-order-equipment-group {
  border-top: 1px solid rgba(8, 117, 111, 0.14);
  display: grid;
  gap: 12px;
  padding-top: 14px;
}

.ets-work-order-equipment-group__header {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: space-between;
}

.ets-work-order-equipment-group__header p,
.ets-work-order-equipment-group__header h4 {
  margin: 0;
}

.ets-work-order-equipment-group__header p {
  color: var(--myc-soft-text);
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
}

.ets-work-order-equipment-group__header h4 {
  color: var(--myc-navy);
  font-size: 18px;
  font-weight: 900;
}

.ets-equipment-notes {
  display: grid;
  gap: 8px;
  margin: 0;
}

.ets-equipment-notes article {
  background: rgba(255, 255, 255, 0.38);
  border-radius: 8px;
  padding: 8px;
}

.ets-equipment-notes span {
  color: var(--myc-soft-text);
  font-size: 11px;
  font-weight: 850;
  text-transform: uppercase;
}

.ets-equipment-notes p {
  color: var(--myc-navy);
  font-size: 13px;
  font-weight: 800;
  margin: 3px 0 0;
  overflow-wrap: anywhere;
}

.ets-certificate-capacity-list {
  display: grid;
  gap: 8px;
}

.ets-certificate-capacity-list article {
  align-items: center;
  background: rgba(255, 255, 255, 0.42);
  border: 1px solid rgba(201, 255, 247, 0.42);
  border-radius: 8px;
  display: flex;
  justify-content: space-between;
  min-height: 46px;
  padding: 10px 12px;
}

.ets-certificate-capacity-list span {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 850;
}

.ets-certificate-capacity-list strong {
  color: var(--myc-primary-dark);
  font-size: 18px;
}

.ets-condition-presets,
.ets-picker-pagination {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 8px 0;
}

.ets-picker-pagination {
  justify-content: space-between;
}

.ets-picker-pagination span {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 850;
}

.service-order-checkbox {
  align-items: center;
  display: flex !important;
  gap: 10px !important;
  justify-content: flex-start;
}

.service-order-checkbox input {
  accent-color: var(--myc-primary);
  height: 18px;
  width: 18px;
}

.field-sheet-prep-list {
  display: grid;
  gap: 10px;
}

.glass-card-mini {
  align-items: center;
  background: rgba(255, 255, 255, 0.34);
  border: 1px solid rgba(201, 255, 247, 0.34);
  border-radius: 8px;
  display: grid;
  gap: 8px;
  grid-template-columns: 1fr 1.4fr auto;
  padding: 12px;
}

.glass-card-mini strong {
  color: var(--myc-navy);
}

.glass-card-mini span {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 760;
}

.field-sheet-modal {
  max-width: min(1180px, 96vw);
}

.field-sheet-form-grid {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.field-sheet-form-grid label {
  color: var(--myc-soft-text);
  display: grid;
  font-size: 13px;
  font-weight: 850;
  gap: 7px;
}

.field-sheet-form-grid input,
.field-sheet-form-grid select,
.field-sheet-form-grid textarea {
  background: rgba(255, 255, 255, 0.68);
  border: 1px solid rgba(8, 117, 111, 0.18);
  border-radius: 8px;
  color: var(--myc-navy);
  font: inherit;
  min-height: 42px;
  outline: none;
  padding: 10px 12px;
}

.field-sheet-form-grid textarea {
  font-weight: 720;
  min-height: 82px;
  resize: vertical;
}

.field-sheet-form-grid input:focus,
.field-sheet-form-grid select:focus,
.field-sheet-form-grid textarea:focus {
  border-color: var(--myc-primary);
  box-shadow: 0 0 0 3px rgba(70, 216, 196, 0.16);
}

.field-sheet-results-stack {
  display: grid;
  gap: 12px;
  margin-bottom: 14px;
}

.field-sheet-results-panel {
  background: rgba(255, 255, 255, 0.22);
  border: 1px solid rgba(201, 255, 247, 0.28);
  border-radius: 8px;
  padding: 12px;
}

.field-sheet-results-table .clients-table__head,
.field-sheet-results-table .clients-table__row {
  grid-template-columns: 60px repeat(6, minmax(130px, 1fr));
}

.field-sheet-results-row input {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(8, 117, 111, 0.16);
  border-radius: 8px;
  color: var(--myc-navy);
  font: inherit;
  min-height: 36px;
  outline: none;
  padding: 8px 10px;
  width: 100%;
}

.field-sheet-results-row input:focus {
  border-color: var(--myc-primary);
  box-shadow: 0 0 0 3px rgba(70, 216, 196, 0.14);
}

.field-sheet-reference-builder {
  display: grid;
  gap: 10px;
}

.field-sheet-reference-list {
  display: grid;
  gap: 10px;
}

.field-sheet-reference-card {
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.3);
  border: 1px solid rgba(201, 255, 247, 0.3);
  border-radius: 8px;
  display: flex;
  gap: 12px;
  justify-content: space-between;
  padding: 12px;
}

.field-sheet-reference-card div {
  display: grid;
  gap: 4px;
}

.field-sheet-reference-card span {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 700;
}

.field-sheet-reference-empty {
  color: var(--myc-soft-text);
  font-size: 13px;
}

.read-only-grid article {
  background: rgba(255, 255, 255, 0.34);
  border: 1px solid rgba(201, 255, 247, 0.34);
  border-radius: 8px;
  color: var(--myc-soft-text);
  display: grid;
  gap: 7px;
  padding: 12px;
}

.read-only-grid span {
  color: var(--myc-primary);
  font-size: 12.5px;
  font-weight: 850;
  text-transform: uppercase;
}

.read-only-grid strong {
  color: var(--myc-navy);
  font-size: 14px;
  font-weight: 760;
  line-height: 1.45;
  white-space: pre-wrap;
}

.toolbar-actions {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  justify-content: flex-end;
}

.inline-select-field {
  align-items: center;
  color: var(--myc-soft-text);
  display: inline-flex !important;
  font-size: 12.5px;
  font-weight: 850;
  gap: 8px !important;
}

.inline-select-field select {
  background: rgba(255, 255, 255, 0.68);
  border: 1px solid rgba(8, 117, 111, 0.18);
  border-radius: 8px;
  color: var(--myc-navy);
  font: inherit;
  min-height: 34px;
  outline: none;
  padding: 0 10px;
}

.toolbar-actions .table-button,
.table-button {
  align-items: center;
  display: inline-flex;
  gap: 7px;
  justify-content: center;
}

.quotation-row-button {
  appearance: none;
  cursor: pointer;
  text-align: left;
  transition:
    background 160ms ease,
    border-color 160ms ease,
    box-shadow 160ms ease,
    transform 160ms ease;
  width: 100%;
}

.quotation-row-button:hover,
.quotation-row-button:focus-visible {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.48), rgba(70, 216, 196, 0.18)),
    rgba(255, 255, 255, 0.34);
  border-color: rgba(70, 216, 196, 0.56);
  box-shadow: 0 14px 30px rgba(5, 31, 45, 0.11), 0 0 0 3px rgba(70, 216, 196, 0.12);
  outline: none;
  transform: translateY(-1px);
}

.module-tabs {
  backdrop-filter: blur(18px) saturate(145%);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.38), rgba(70, 216, 196, 0.12)),
    rgba(255, 255, 255, 0.22);
  border: 1px solid var(--glass-border);
  border-radius: 8px;
  box-shadow: 0 16px 36px rgba(5, 31, 45, 0.08);
  display: inline-grid;
  gap: 7px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding: 7px;
  width: min(720px, 100%);
}

.module-tab {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 6px;
  color: var(--myc-soft-text);
  cursor: pointer;
  font-size: 14px;
  font-weight: 850;
  min-height: 42px;
  padding: 0 14px;
}

.module-tab.is-active {
  background:
    linear-gradient(135deg, rgba(232, 250, 247, 0.88), rgba(201, 255, 247, 0.5)),
    rgba(255, 255, 255, 0.45);
  border-color: rgba(8, 117, 111, 0.22);
  box-shadow: 0 12px 24px rgba(5, 31, 45, 0.08);
  color: var(--myc-primary-dark);
}

.module-tabs--five {
  grid-template-columns: repeat(5, minmax(0, 1fr));
  width: min(1080px, 100%);
}

.status-pill {
  background: rgba(232, 250, 247, 0.78);
  border: 1px solid rgba(8, 117, 111, 0.22);
  border-radius: 999px;
  color: #074c49;
  display: inline-flex;
  font-size: 12px;
  font-weight: 850;
  padding: 5px 9px;
}

.status-pill--muted {
  background: rgba(235, 241, 245, 0.72);
  border-color: rgba(55, 80, 99, 0.22);
  color: #253d4f;
}

.status-pill--danger {
  background: rgba(255, 236, 232, 0.82);
  border-color: rgba(172, 54, 38, 0.24);
  color: #8d2a1d;
}

.quotation-status {
  border-radius: 999px;
  display: inline-flex;
  font-size: 12px;
  font-weight: 850;
  padding: 5px 9px;
}

.quotation-status.status-draft {
  background: rgba(235, 241, 245, 0.76);
  border: 1px solid rgba(55, 80, 99, 0.22);
  color: #253d4f;
}

.quotation-status.status-sent,
.quotation-status.status-waiting,
.quotation-status.status-generated,
.quotation-status.status-quality_review,
.quotation-status.status-under_review {
  background: rgba(229, 249, 250, 0.76);
  border: 1px solid rgba(24, 117, 129, 0.24);
  color: #0b5d67;
}

.quotation-status.status-accepted,
.quotation-status.status-approved,
.quotation-status.status-released,
.quotation-status.status-completed,
.quotation-status.status-calibrated,
.quotation-status.status-labeled {
  background: rgba(232, 250, 247, 0.8);
  border: 1px solid rgba(8, 117, 111, 0.24);
  color: #074c49;
}

.quotation-status.status-rejected,
.quotation-status.status-expired,
.quotation-status.status-cancelled,
.quotation-status.status-suspended,
.quotation-status.status-not_done {
  background: rgba(254, 242, 242, 0.84);
  border: 1px solid rgba(220, 38, 38, 0.22);
  color: #991b1b;
}

.clients-table__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.table-button {
  background: rgba(255, 255, 255, 0.56);
  border: 1px solid rgba(8, 117, 111, 0.16);
  border-radius: 6px;
  color: var(--myc-primary-dark);
  font-size: 13px;
  font-weight: 850;
  min-height: 34px;
  padding: 0 10px;
}

.table-button--primary {
  background: linear-gradient(135deg, var(--myc-primary), #099d91);
  border-color: transparent;
  color: #ffffff;
}

.table-button--danger {
  background: rgba(254, 242, 242, 0.9);
  border-color: rgba(220, 38, 38, 0.22);
  color: #991b1b;
}

.quality-actions {
  justify-content: flex-start;
}

.clients-empty {
  background: rgba(255, 255, 255, 0.28);
  border: 1px dashed rgba(8, 117, 111, 0.24);
  border-radius: 8px;
  color: var(--myc-soft-text);
  font-weight: 800;
  padding: 18px;
}

.quotation-detail-modal {
  max-width: 1080px;
  width: min(1080px, 100%);
}

/* El expediente ETS contiene navegación,
tablas y acordeones operativos que
   necesitan más superficie que un modal comercial convencional. */
.service-order-modal {
  max-height: calc(100vh - 32px);
  max-height: calc(100dvh - 32px);
  max-width: 1480px;
  width: min(1480px, calc(100vw - 40px));
}

.field-sheet-create-modal {
  max-width: 820px;
  padding: 18px;
  width: min(820px, 100%);
}

.field-sheet-create-modal .quotation-detail-header {
  margin-bottom: 12px;
  padding: 13px 15px;
}

.field-sheet-create-form {
  display: grid;
  gap: 12px;
}

.field-sheet-create-section {
  background: rgba(255, 255, 255, 0.32);
  border: 1px solid rgba(8, 117, 111, 0.15);
  border-radius: 8px;
  display: grid;
  gap: 12px;
  padding: 14px;
}

.field-sheet-create-section__heading {
  align-items: end;
  display: flex;
  gap: 12px;
  justify-content: space-between;
}

.field-sheet-create-section__heading > div {
  align-items: center;
  display: flex;
  gap: 8px;
}

.field-sheet-create-section__heading > div > span {
  align-items: center;
  background: var(--myc-primary);
  border-radius: 999px;
  color: white;
  display: inline-flex;
  font-size: 12px;
  font-weight: 900;
  height: 24px;
  justify-content: center;
  width: 24px;
}

.field-sheet-create-section__heading h3 {
  color: var(--myc-navy);
  font-size: 17px;
  margin: 0;
}

.field-sheet-create-section__heading small,
.field-sheet-client-choice small,
.field-sheet-inline-check small {
  color: #607482;
  font-size: 12px;
  font-weight: 650;
}

.field-sheet-client-choice-grid {
  display: grid;
  gap: 10px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.field-sheet-client-choice {
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.48);
  border: 1px solid rgba(8, 117, 111, 0.2);
  border-radius: 8px;
  color: var(--myc-navy);
  cursor: pointer;
  display: flex;
  gap: 10px;
  min-height: 68px;
  padding: 12px;
  text-align: left;
}

.field-sheet-client-choice:hover,
.field-sheet-client-choice.is-active {
  background: rgba(232, 255, 250, 0.82);
  border-color: var(--myc-primary);
  box-shadow: 0 0 0 2px rgba(70, 216, 196, 0.14);
}

.field-sheet-client-choice > span:last-child {
  display: grid;
  gap: 3px;
}

.field-sheet-choice-dot {
  background: white;
  border: 2px solid #8ca3ad;
  border-radius: 999px;
  flex: 0 0 auto;
  height: 17px;
  margin-top: 1px;
  width: 17px;
}

.field-sheet-client-choice.is-active .field-sheet-choice-dot {
  border: 5px solid var(--myc-primary);
}

.field-sheet-client-summary {
  align-items: center;
  background: rgba(240, 248, 249, 0.72);
  border-radius: 7px;
  display: grid;
  gap: 8px;
  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr) auto;
  padding: 10px 12px;
}

.field-sheet-client-summary > div {
  display: grid;
  gap: 2px;
  min-width: 0;
}

.field-sheet-client-summary span {
  color: #607482;
  font-size: 10px;
  font-weight: 850;
  text-transform: uppercase;
}

.field-sheet-client-summary strong {
  color: var(--myc-navy);
  font-size: 12px;
  overflow-wrap: anywhere;
}

.field-sheet-create-field,
.certificate-client-form label,
.certificate-client-save-options > label:not(.field-sheet-inline-check) {
  color: var(--myc-soft-text);
  display: grid;
  font-size: 13px;
  font-weight: 800;
  gap: 6px;
}

.field-sheet-create-field input,
.field-sheet-create-field select,
.certificate-client-form input,
.certificate-client-form textarea,
.certificate-client-save-options input {
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(8, 117, 111, 0.2);
  border-radius: 6px;
  color: var(--myc-navy);
  min-height: 40px;
  outline: none;
  padding: 8px 11px;
  width: 100%;
}

.field-sheet-inline-check {
  align-items: flex-start;
  color: var(--myc-navy);
  cursor: pointer;
  display: flex;
  font-size: 13px;
  gap: 9px;
}

.field-sheet-inline-check input[type='checkbox'] {
  accent-color: var(--myc-primary);
  flex: 0 0 auto;
  height: 17px;
  margin: 1px 0 0;
  min-height: 0;
  padding: 0;
  width: 17px;
}

.field-sheet-inline-check > span {
  display: grid;
  gap: 2px;
}

.field-sheet-create-actions {
  align-items: center;
  display: flex;
  gap: 10px;
  justify-content: flex-end;
  padding-top: 2px;
}

.modal-backdrop--nested {
  background: rgba(5, 31, 45, 0.64);
  z-index: 40;
}

.certificate-client-modal {
  max-width: 680px;
  width: min(680px, 100%);
}

.certificate-client-help {
  color: #4d6571;
  font-size: 13px;
  line-height: 1.45;
  margin: 4px 0 14px;
}

.certificate-client-form {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin: 14px 0;
}

.certificate-client-form .form-field--wide {
  grid-column: 1 / -1;
}

.certificate-client-save-options {
  background: rgba(255, 255, 255, 0.34);
  border-radius: 7px;
  display: grid;
  gap: 12px;
  grid-template-columns: minmax(0, 1fr) auto;
  margin-top: 12px;
  padding: 12px;
}

.certificate-client-save-options .field-sheet-inline-check {
  align-self: end;
  padding-bottom: 10px;
}

.quotation-status.status-pending,
.quotation-status.status-progress {
  background: rgba(245, 158, 11, 0.14);
  color: #92400e;
}

.ets-field-sheet-subtabs {
  background: rgba(255, 255, 255, 0.3);
  border: 1px solid rgba(8, 117, 111, 0.16);
  border-radius: 8px;
  display: grid;
  gap: 7px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-bottom: 12px;
  padding: 6px;
}

.ets-field-sheet-subtabs button {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 6px;
  color: #607482;
  cursor: pointer;
  font-weight: 850;
  min-height: 40px;
}

.ets-field-sheet-subtabs button.is-active {
  background: rgba(255, 255, 255, 0.78);
  border-color: rgba(8, 117, 111, 0.24);
  color: var(--myc-primary);
  box-shadow: 0 6px 18px rgba(5, 31, 45, 0.08);
}

.ets-field-sheet-capture-card {
  align-items: center;
  display: grid;
  gap: 12px;
  grid-template-columns: minmax(190px, 1fr) 120px 150px auto minmax(210px, auto);
}

.ets-field-sheet-capture-card > div:not(.toolbar-actions) {
  display: grid;
  gap: 3px;
}

.ets-field-sheet-capture-card small,
.ets-field-sheet-work-order small {
  color: #6a7e88;
  font-size: 9px;
  font-weight: 850;
  text-transform: uppercase;
}

.ets-field-sheet-work-orders,
.ets-field-sheet-work-order__equipment {
  display: grid;
  gap: 9px;
}

.ets-field-sheet-work-order {
  background: rgba(255, 255, 255, 0.3);
  border: 1px solid rgba(8, 117, 111, 0.16);
  border-radius: 8px;
  overflow: hidden;
}

.ets-field-sheet-work-order.is-expanded {
  border-color: rgba(8, 117, 111, 0.34);
  box-shadow: 0 10px 28px rgba(5, 31, 45, 0.1);
}

.ets-field-sheet-work-order__summary {
  align-items: center;
  background: transparent;
  border: 0;
  color: inherit;
  cursor: pointer;
  display: grid;
  gap: 13px;
  grid-template-columns: 24px minmax(170px, .65fr) minmax(380px, 1.4fr) minmax(150px, .55fr) auto;
  padding: 14px;
  text-align: left;
  width: 100%;
}

.ets-field-sheet-work-order__summary:hover {
  background: rgba(255, 255, 255, 0.3);
}

.ets-field-sheet-work-order__summary > div:nth-child(2),
.ets-field-sheet-equipment-row > div:first-child {
  display: grid;
  gap: 3px;
}

.ets-field-sheet-work-order__summary > div:nth-child(2) > strong {
  color: var(--myc-navy);
  font-size: 17px;
}

.ets-field-sheet-work-order__summary > div:nth-child(2) > span,
.ets-field-sheet-equipment-row > div:first-child > span {
  color: #607482;
  font-size: 11px;
}

.ets-field-sheet-work-order__metrics {
  display: grid;
  gap: 7px;
  grid-template-columns: repeat(5, minmax(55px, 1fr));
}

.ets-field-sheet-work-order__metrics > span {
  color: #607482;
  display: grid;
  font-size: 9px;
  gap: 2px;
  text-align: center;
  text-transform: uppercase;
}

.ets-field-sheet-work-order__metrics strong {
  color: var(--myc-navy);
  font-size: 15px;
}

.ets-field-sheet-work-order__progress {
  display: grid;
  gap: 3px;
}

.ets-field-sheet-work-order__progress > div {
  background: rgba(8, 117, 111, 0.12);
  border-radius: 999px;
  height: 8px;
  overflow: hidden;
}

.ets-field-sheet-work-order__progress > div > span {
  background: linear-gradient(90deg, var(--myc-primary), #45d7c4);
  display: block;
  height: 100%;
}

.ets-field-sheet-work-order__progress strong {
  color: var(--myc-navy);
  font-size: 11px;
}

.ets-field-sheet-work-order__equipment {
  border-top: 1px solid rgba(8, 117, 111, 0.14);
  padding: 9px;
}

.ets-field-sheet-equipment-row {
  align-items: center;
  background: rgba(255, 255, 255, 0.48);
  border-radius: 7px;
  display: grid;
  gap: 11px;
  grid-template-columns: minmax(150px, .55fr) minmax(420px, 1.6fr) auto minmax(210px, auto);
  padding: 11px;
}

.ets-field-sheet-equipment-row dl {
  display: grid;
  gap: 7px 12px;
  grid-template-columns: repeat(5, minmax(75px, 1fr));
  margin: 0;
}

.ets-field-sheet-equipment-row dl > div {
  display: grid;
  gap: 2px;
}

.ets-field-sheet-equipment-row dt {
  color: #6a7e88;
  font-size: 9px;
  font-weight: 850;
  text-transform: uppercase;
}

.ets-field-sheet-equipment-row dd {
  color: var(--myc-navy);
  font-size: 11px;
  font-weight: 750;
  margin: 0;
  overflow-wrap: anywhere;
}

@media (max-width: 1180px) {
  .ets-field-sheet-capture-card,
.ets-field-sheet-work-order__summary,
.ets-field-sheet-equipment-row {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  .field-sheet-client-choice-grid,
.certificate-client-form,
.certificate-client-save-options {
    grid-template-columns: 1fr;
  }

  .field-sheet-client-summary {
    grid-template-columns: 1fr;
  }

  .field-sheet-create-section__heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .ets-field-sheet-subtabs,
.ets-field-sheet-work-order__metrics,
.ets-field-sheet-equipment-row dl {
    grid-template-columns: 1fr;
  }
}

.quotation-modal {
  max-width: 960px;
  width: min(960px, 100%);
}

.quotations-workspace {
  gap: 22px;
}

.quotation-detail-form {
  display: grid;
  gap: 14px;
}

.quotation-detail-header {
  align-items: center;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.42), rgba(70, 216, 196, 0.16)),
    rgba(255, 255, 255, 0.24);
  border: 1px solid rgba(201, 255, 247, 0.4);
  border-radius: 8px;
  display: grid;
  gap: 14px;
  grid-template-columns: minmax(0, 1fr) auto auto auto;
  margin-bottom: 16px;
  padding: 16px;
}

.quotation-detail-header p,
.quotation-section__title p {
  color: var(--myc-primary);
  font-size: 12.5px;
  font-weight: 850;
  letter-spacing: 0;
  margin: 0 0 5px;
  text-transform: uppercase;
}

.quotation-detail-header h2 {
  color: var(--myc-navy);
  font-size: clamp(26px, 3vw, 36px);
  font-weight: 850;
  line-height: 1.08;
  margin: 0;
}

.quotation-detail-header span {
  color: var(--myc-soft-text);
  display: block;
  font-size: 15px;
  font-weight: 800;
  margin-top: 6px;
}

.quotation-status--large {
  align-items: center;
  font-size: 14px;
  justify-content: center;
  min-height: 42px;
  padding: 0 16px;
}

.quotation-pdf-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: flex-end;
}

.quotation-pdf-actions .table-button {
  white-space: nowrap;
}

.template-editor-layout {
  align-items: start;
  display: grid;
  gap: 18px;
  grid-template-columns: minmax(0, 1.08fr) minmax(380px, 0.92fr);
}

.template-editor-form {
  display: grid;
  gap: 14px;
}

.template-editor-grid {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.template-editor-form label,
.template-toggle-list label {
  color: var(--myc-soft-text);
  display: grid;
  font-size: 13px;
  font-weight: 800;
  gap: 7px;
}

.template-editor-form input,
.template-editor-form textarea {
  background: rgba(255, 255, 255, 0.64);
  border: 1px solid rgba(12, 118, 123, 0.22);
  border-radius: 8px;
  color: var(--myc-navy);
  font: inherit;
  font-weight: 700;
  padding: 10px 12px;
  resize: vertical;
}

.template-toggle-list {
  display: grid;
  gap: 10px;
}

.template-toggle-list label {
  align-items: center;
  background: rgba(255, 255, 255, 0.38);
  border: 1px solid rgba(201, 255, 247, 0.34);
  border-radius: 8px;
  display: flex;
  padding: 10px 12px;
}

.template-toggle-list input {
  accent-color: var(--myc-primary);
}

.template-live-preview {
  position: sticky;
  top: 18px;
}

.quotation-sheet__meta--four {
  grid-template-columns: 1.2fr 1fr 1fr 1fr;
}

.quotation-section {
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.34), rgba(70, 216, 196, 0.09)),
    rgba(255, 255, 255, 0.22);
  border: 1px solid rgba(201, 255, 247, 0.38);
  border-radius: 8px;
  margin-bottom: 14px;
  padding: 15px;
}

.quotation-section__title {
  align-items: baseline;
  display: flex;
  gap: 12px;
  justify-content: space-between;
  margin-bottom: 12px;
}

.quotation-section__title h3 {
  color: var(--myc-navy);
  font-size: 18px;
  font-weight: 850;
  margin: 0;
}

.quotation-section__title--stacked {
  align-items: stretch;
  flex-direction: column;
  gap: 12px;
}

.quotation-section__title--stacked .ets-stage-note {
  box-sizing: border-box;
  margin: 0;
  overflow-wrap: anywhere;
  width: 100%;
}

.quotation-summary {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.quotation-summary div,
.quotation-commercial-grid article,
.quotation-commercial-grid label {
  background: rgba(255, 255, 255, 0.3);
  border: 1px solid rgba(201, 255, 247, 0.36);
  border-radius: 8px;
  padding: 13px;
}

.quotation-total-card {
  background:
    linear-gradient(135deg, rgba(8, 117, 111, 0.14), rgba(70, 216, 196, 0.18)),
    rgba(255, 255, 255, 0.38) !important;
  border-color: rgba(70, 216, 196, 0.42) !important;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.62);
}

.quotation-summary span,
.quotation-commercial-grid span,
.quotation-commercial-grid label,
.quotation-notes-field {
  color: var(--myc-soft-text);
  display: block;
  font-size: 12.5px;
  font-weight: 850;
  margin-bottom: 5px;
  text-transform: uppercase;
}

.quotation-summary strong,
.quotation-commercial-grid strong {
  color: var(--myc-navy);
  display: block;
  font-size: 16px;
  line-height: 1.35;
}

.quotation-total-card strong {
  color: var(--myc-primary-dark);
  font-size: 26px;
}

.quotation-commercial-grid {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.quotation-commercial-grid input,
.quotation-notes-field textarea {
  background: rgba(255, 255, 255, 0.58);
  border: 1px solid rgba(8, 117, 111, 0.18);
  border-radius: 6px;
  color: var(--myc-navy);
  font-size: 14px;
  font-weight: 750;
  outline: none;
  width: 100%;
}

.quotation-commercial-grid input {
  min-height: 42px;
  padding: 0 12px;
}

.quotation-notes-field textarea {
  min-height: 110px;
  padding: 11px 12px;
  resize: vertical;
  text-transform: none;
}

.field-sheet-action-panel {
  margin-top: 28px;
  padding-top: 20px;
  border-top: 1px solid rgba(16, 24, 40, 0.14);
}

.field-sheet-action-panel {
  margin-top: 28px;
  margin-bottom: 20px;
  padding-top: 20px;
  border-top: 1px solid rgba(16, 24, 40, 0.14);
}

.field-sheet-admin-actions {
  margin-top: 24px;
  padding-top: 18px;
  border-top: 1px solid rgba(180, 35, 24, 0.15);
}

.field-sheet-action-panel {
  margin-top: 28px;
  padding-top: 20px;
  border-top: 1px solid rgba(16, 24, 40, 0.12);
}

.quotation-detail-save {
  align-items: center;
  display: flex;
  gap: 14px;
  justify-content: space-between;
  margin: -2px 0 14px;
}

.quotation-detail-save span {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 780;
}

/* El detalle de equipo reúne información operativa y varias acciones. Este
   separador evita que los controles queden visualmente pegados a las notas. */
.ets-equipment-condition-section {
  margin: 24px 0 0;
}

.ets-equipment-detail-actions {
  align-items: flex-start;
  border-top: 1px solid rgba(6, 52, 60, 0.16);
  margin: 24px 0 4px;
  padding-top: 20px;
}

.ets-equipment-detail-actions > span {
  flex: 0 1 310px;
  line-height: 1.45;
  padding: 8px 0;
}

.ets-equipment-detail-actions .toolbar-actions {
  flex: 1 1 520px;
  justify-content: flex-end;
}

@media (max-width: 680px) {
  .ets-equipment-detail-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .ets-equipment-detail-actions .toolbar-actions {
    justify-content: flex-start;
  }
}

.quotation-client-card {
  align-items: flex-start;
}

.quotation-client-card .table-button {
  margin-top: 10px;
}

.quotation-client-picker {
  max-width: 760px;
}

.quotation-client-results {
  display: grid;
  gap: 10px;
  max-height: min(56vh, 520px);
  overflow: auto;
  padding-right: 4px;
}

.quotation-client-result {
  background: rgba(255, 255, 255, 0.32);
  border: 1px solid rgba(201, 255, 247, 0.42);
  border-radius: 8px;
  color: var(--myc-text);
  cursor: pointer;
  display: grid;
  gap: 5px;
  padding: 12px;
  text-align: left;
}

.quotation-client-result:hover,
.quotation-client-result:focus-visible {
  border-color: rgba(22, 148, 140, 0.5);
  box-shadow: 0 12px 24px rgba(9, 44, 54, 0.12);
  outline: none;
}

.quotation-client-result strong {
  color: var(--myc-navy);
}

.quotation-client-result span,
.quotation-client-result small {
  color: var(--myc-soft-text);
  font-weight: 760;
}

.empty-state {
  color: var(--myc-soft-text);
  font-size: 14px;
  font-weight: 760;
  margin: 0;
  padding: 14px;
  text-align: center;
}

.quotation-future-area {
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.28), rgba(70, 216, 196, 0.08)),
    rgba(255, 255, 255, 0.18);
  border: 1px solid rgba(201, 255, 247, 0.32);
  border-radius: 8px;
  margin-bottom: 0;
  padding: 13px;
}

.quotation-future-area h3 {
  color: var(--myc-navy);
  font-size: 17px;
  margin: 0 0 8px;
}

.quotation-future-area div {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.quotation-future-area span {
  background: rgba(232, 250, 247, 0.62);
  border: 1px solid rgba(8, 117, 111, 0.16);
  border-radius: 999px;
  color: var(--myc-primary-dark);
  font-size: 12.5px;
  font-weight: 850;
  padding: 6px 10px;
}

.quotation-actions {
  background: rgba(255, 255, 255, 0.26);
  border: 1px solid rgba(201, 255, 247, 0.34);
  border-radius: 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: flex-end;
  padding: 10px;
}

.catalog-note {
  margin-bottom: 14px;
}

.catalog-rules {
  margin-bottom: 14px;
}

.catalog-category-map {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-bottom: 14px;
}

.catalog-category-map section {
  background: rgba(255, 255, 255, 0.22);
  border: 1px solid rgba(201, 255, 247, 0.32);
  border-radius: 8px;
  padding: 13px;
}

.catalog-category-map h3 {
  color: var(--myc-navy);
  font-size: 15px;
  margin: 0 0 10px;
}

.import-modal {
  max-width: 940px;
  width: min(940px, 100%);
}

.import-upload-zone {
  align-items: center;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.34), rgba(70, 216, 196, 0.1)),
    rgba(255, 255, 255, 0.22);
  border: 1px dashed rgba(8, 117, 111, 0.34);
  border-radius: 8px;
  display: grid;
  gap: 14px;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  margin-bottom: 14px;
  padding: 15px;
}

.import-upload-zone--clients {
  grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.2fr);
}

.import-upload-zone__control {
  display: grid;
  gap: 8px;
}

.import-upload-zone__control span {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 850;
  text-transform: uppercase;
}

.import-upload-zone label,
.catalog-filters label {
  color: var(--myc-soft-text);
  display: grid;
  font-size: 13px;
  font-weight: 850;
  gap: 7px;
  text-transform: uppercase;
}

.import-upload-zone input,
.catalog-filters input,
.catalog-filters select {
  background: rgba(255, 255, 255, 0.58);
  border: 1px solid rgba(8, 117, 111, 0.18);
  border-radius: 6px;
  color: var(--myc-navy);
  min-height: 40px;
  padding: 0 11px;
}

.import-upload-zone strong {
  color: var(--myc-navy);
  display: block;
  font-size: 16px;
  margin-bottom: 5px;
}

.import-upload-zone span {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 760;
}

.client-file-indicator {
  display: grid;
  gap: 4px;
  min-width: 0;
}

.client-file-indicator strong,
.client-file-indicator span {
  overflow-wrap: anywhere;
}

.import-template-grid {
  display: grid;
  gap: 10px;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin: 14px 0;
}

.import-template-grid article,
.price-preview-card {
  background: rgba(255, 255, 255, 0.3);
  border: 1px solid rgba(201, 255, 247, 0.36);
  border-radius: 8px;
  padding: 13px;
}

.import-template-grid span,
.price-preview-card span {
  color: var(--myc-soft-text);
  display: block;
  font-size: 12.5px;
  font-weight: 850;
  margin-bottom: 6px;
  text-transform: uppercase;
}

.import-template-grid strong,
.price-preview-card strong {
  color: var(--myc-primary-dark);
  display: block;
  font-size: 26px;
  line-height: 1;
}

.price-preview-card small {
  color: var(--myc-soft-text);
  display: block;
  font-size: 12px;
  font-weight: 760;
  line-height: 1.35;
  margin-top: 8px;
}

/* El resumen financiero no comparte renglón con controles: de otro modo el
   label de Estado adopta la altura de la tarjeta por el estiramiento del grid. */
.client-form--modal .price-preview-card--catalog {
  grid-column: 1 / -1;
}

.client-form--modal .catalog-status-field {
  align-content: start;
  align-self: start;
  grid-auto-rows: min-content;
}

.import-preview-section {
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(201, 255, 247, 0.3);
  border-radius: 8px;
  margin-bottom: 14px;
  padding: 14px;
}

.import-preview-section h3 {
  color: var(--myc-navy);
  font-size: 17px;
  margin: 0 0 10px;
}

.import-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.import-chip-list span {
  background: rgba(232, 250, 247, 0.68);
  border: 1px solid rgba(8, 117, 111, 0.16);
  border-radius: 999px;
  color: var(--myc-primary-dark);
  font-size: 12.5px;
  font-weight: 850;
  padding: 6px 10px;
}

.import-preview-list {
  display: grid;
  gap: 8px;
}

.import-row {
  background: rgba(255, 255, 255, 0.32);
  border: 1px solid rgba(201, 255, 247, 0.34);
  border-left: 4px solid var(--myc-primary);
  border-radius: 8px;
  display: grid;
  gap: 4px;
  padding: 10px 12px;
}

.import-row strong {
  color: var(--myc-navy);
}

.import-row span,
.import-row small {
  color: var(--myc-soft-text);
  font-weight: 760;
}

.import-row--duplicate {
  border-left-color: #0b5d67;
}

.import-row--valid {
  border-left-color: var(--myc-primary);
}

.import-row--error {
  border-left-color: #dc2626;
}

.import-row--warning {
  background: rgba(255, 251, 235, 0.9);
  border-left-color: #d97706;
}

.catalog-filters {
  background: rgba(255, 255, 255, 0.22);
  border: 1px solid rgba(201, 255, 247, 0.32);
  border-radius: 8px;
  display: grid;
  gap: 10px;
  grid-template-columns: minmax(220px, 1.5fr) 0.68fr 0.9fr 0.62fr 0.62fr;
  margin-bottom: 14px;
  padding: 10px;
}

.catalog-search-field {
  min-width: 0;
}

.quotation-detail-tabs {
  position: static;
}

.quotation-items-table {
  display: grid;
  gap: 8px;
  margin-bottom: 14px;
}

.quotation-items-table__head,
.quotation-items-table__row {
  display: grid;
  gap: 10px;
  grid-template-columns: minmax(220px, 1.5fr) 0.55fr 0.72fr 0.86fr 0.68fr 0.82fr 1.05fr;
}

.quotation-items-table__head {
  color: var(--myc-primary-dark);
  font-size: 12px;
  font-weight: 900;
  padding: 0 10px;
  text-transform: uppercase;
}

.quotation-items-table__row {
  align-items: center;
  background: rgba(255, 255, 255, 0.3);
  border: 1px solid rgba(201, 255, 247, 0.34);
  border-radius: 8px;
  color: var(--myc-soft-text);
  font-size: 13.5px;
  font-weight: 760;
  min-height: 52px;
  padding: 10px;
}

.quotation-items-table__row--draft {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.42), rgba(70, 216, 196, 0.1)),
    rgba(255, 255, 255, 0.3);
  border-color: rgba(70, 216, 196, 0.42);
}

.quotation-items-table__row input,
.quotation-items-table__row select,
.quotation-items-table__row textarea {
  background: rgba(255, 255, 255, 0.68);
  border: 1px solid rgba(8, 117, 111, 0.18);
  border-radius: 6px;
  color: var(--myc-navy);
  font-size: 13px;
  font-weight: 760;
  min-height: 36px;
  outline: none;
  padding: 0 9px;
  width: 100%;
}

.quotation-items-table__row textarea.quote-line-description {
  min-height: 76px;
  padding: 9px;
  resize: vertical;
}

.quotation-items-table__row input:focus,
.quotation-items-table__row select:focus {
  border-color: var(--myc-primary);
  box-shadow: 0 0 0 3px rgba(70, 216, 196, 0.16);
}

.quote-line-concept {
  display: grid;
  gap: 7px;
}

.quote-service-picker { position: relative; }
.quote-service-picker__menu {
  background: #fff;
  border: 1px solid rgba(8, 117, 111, .25);
  border-radius: 8px;
  box-shadow: 0 12px 28px rgba(7, 41, 62, .18);
  display: grid;
  left: 0;
  max-height: 240px;
  overflow: auto;
  position: absolute;
  right: 0;
  top: calc(100% + 4px);
  z-index: 20;
}
.quote-service-picker__menu button { background: transparent; border: 0; color: var(--myc-navy); cursor: pointer; display: grid; gap: 2px; padding: 9px 11px; text-align: left; }
.quote-service-picker__menu button:hover,
.quote-service-picker__menu button:focus { background: rgba(70, 216, 196, .14); outline: 0; }
.quote-service-picker__menu small { color: var(--myc-soft-text); }

.quote-line-concept small {
  color: var(--myc-soft-text);
  font-size: 12px;
  font-weight: 760;
}

.quotation-summary--items {
  margin-top: 12px;
}

.quotation-history-list {
  display: grid;
  gap: 9px;
}

.quotation-snapshot-list {
  margin-top: 14px;
}

.quotation-history-list article {
  align-items: center;
  background: rgba(255, 255, 255, 0.28);
  border: 1px solid rgba(201, 255, 247, 0.34);
  border-radius: 8px;
  display: flex;
  justify-content: space-between;
  padding: 12px;
}

.quotation-history-list strong {
  color: var(--myc-navy);
}

.quotation-history-list span {
  color: var(--myc-soft-text);
  font-weight: 760;
}

.quotation-template-panel {
  overflow: visible;
}

.quotation-sheet {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.78), rgba(247, 252, 251, 0.72)),
    rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(8, 117, 111, 0.18);
  border-radius: 8px;
  box-shadow: 0 18px 48px rgba(5, 31, 45, 0.11);
  color: var(--myc-navy);
  padding: 24px;
}

.quotation-sheet__header {
  align-items: center;
  border-bottom: 1px solid rgba(8, 117, 111, 0.16);
  display: flex;
  gap: 20px;
  justify-content: flex-start;
  padding-bottom: 16px;
}

.quotation-sheet__brand {
  align-items: center;
  display: flex;
  gap: 13px;
  max-width: 560px;
}

.quotation-sheet__brand img {
  height: 62px;
  object-fit: contain;
  width: 104px;
}

.quotation-sheet__brand strong {
  color: var(--myc-navy);
  display: block;
  font-size: 24px;
  font-weight: 850;
  line-height: 1.15;
}

.quotation-sheet__brand span,
.quotation-sheet p,
.quotation-sheet__totals small {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 760;
  line-height: 1.45;
}

.quotation-sheet__title-block {
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  margin: 18px auto 14px;
  min-height: 88px;
  padding: 6px 124px !important;
  position: relative;
  text-align: center;
}

.quotation-sheet__title-block p {
  color: var(--myc-primary-dark);
  font-size: clamp(34px, 5vw, 52px);
  font-weight: 900;
  letter-spacing: 0.08em;
  line-height: 1;
  margin: 0;
}

.quotation-sheet__title-block span {
  color: var(--myc-soft-text);
  display: block;
  font-size: 15px;
  font-weight: 800;
  line-height: 1.4;
  margin-top: 10px;
}

.quotation-sheet__document-control {
  background: rgba(232, 250, 247, 0.55);
  border: 1px solid rgba(8, 117, 111, 0.18);
  border-radius: 8px 0 0 8px;
  min-width: 124px;
  padding: 5px 7px;
  position: absolute;
  right: 0;
  text-align: right;
  top: 50%;
  transform: translateY(-50%);
}

.quotation-sheet__document-control span {
  color: var(--myc-primary-dark);
  display: block;
  font-size: 10px;
  font-weight: 900;
  line-height: 1.1;
  margin: 0 0 3px;
  text-transform: uppercase;
}

.quotation-sheet__document-control strong {
  color: var(--myc-navy);
  display: block;
  font-size: 12px;
  font-weight: 900;
  line-height: 1.1;
  margin-bottom: 5px;
}

.quotation-sheet__meta {
  display: grid;
  gap: 12px;
  grid-template-columns: 1.4fr repeat(2, 1fr);
  margin: 16px 0 4px;
  text-align: left;
}

.quotation-sheet__meta-card {
  background: rgba(232, 250, 247, 0.55);
  border: 1px solid rgba(8, 117, 111, 0.18);
  border-radius: 8px;
  padding: 13px 14px;
}

.quotation-sheet__meta-card span {
  color: var(--myc-primary-dark);
  display: block;
  font-size: 12px;
  font-weight: 900;
  margin-bottom: 7px;
  text-transform: uppercase;
}

.quotation-sheet__meta-card strong {
  color: var(--myc-navy);
  display: block;
  font-size: 18px;
  font-weight: 900;
  line-height: 1.15;
}

.quotation-sheet__meta-card--folio {
  background:
    linear-gradient(135deg, rgba(8, 117, 111, 0.13), rgba(70, 216, 196, 0.16)),
    rgba(255, 255, 255, 0.58);
  border-color: rgba(8, 117, 111, 0.28);
}

.quotation-sheet__meta-card--folio strong {
  color: var(--myc-primary-dark);
  font-size: 24px;
}

.quotation-sheet__grid {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 16px;
}

.quotation-sheet section,
.quotation-lines-preview,
.quotation-sheet__totals {
  background: rgba(232, 250, 247, 0.4);
  border: 1px solid rgba(8, 117, 111, 0.12);
  border-radius: 8px;
  padding: 14px;
}

.quotation-sheet h3 {
  color: var(--myc-primary-dark);
  font-size: 16px;
  margin: 0 0 8px;
}

.quotation-lines-preview {
  margin-top: 16px;
}

.quotation-lines-preview__head,
.quotation-lines-preview__row {
  display: grid;
  gap: 8px;
  grid-template-columns: 1.5fr 0.55fr 0.65fr 0.8fr 0.65fr 0.8fr;
}

.quotation-lines-preview__head {
  color: var(--myc-primary-dark);
  font-size: 12px;
  font-weight: 850;
  text-transform: uppercase;
}

.quotation-lines-preview__row {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 760;
  margin-top: 10px;
}

.quotation-sheet__totals {
  display: grid;
  gap: 6px;
  justify-items: end;
  margin-top: 16px;
}

.quotation-sheet__totals span,
.quotation-sheet__totals strong {
  color: var(--myc-navy);
  font-weight: 850;
}

.quotation-sheet__totals strong {
  color: var(--myc-primary-dark);
  font-size: 24px;
}

.operations-band__metric strong {
  color: var(--myc-primary-dark);
  font-size: 32px;
  font-weight: 850;
  line-height: 1;
}

.operations-band__metric span {
  color: var(--myc-soft-text);
  font-size: 13.5px;
  font-weight: 800;
  text-align: right;
}

@media (max-width: 1120px) {
  .modules-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .template-editor-layout {
    grid-template-columns: 1fr;
  }

  .template-live-preview {
    position: static;
  }
}

@media (max-width: 980px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .app-shell--module,
.app-shell--module.is-sidebar-collapsed {
    grid-template-columns: 1fr;
  }

  .sidebar {
    bottom: 0;
    box-shadow: 22px 0 58px rgba(5, 31, 45, 0.28);
    left: 0;
    min-height: 100vh;
    overflow-y: auto;
    padding: 18px;
    position: fixed;
    top: 0;
    transform: translateX(-104%);
    width: min(84vw, 320px);
    z-index: 50;
  }

  .is-mobile-sidebar-open .sidebar {
    transform: translateX(0);
  }

  .sidebar-overlay {
    background: rgba(5, 31, 45, 0.48);
    border: 0;
    bottom: 0;
    left: 0;
    opacity: 0;
    padding: 0;
    pointer-events: none;
    position: fixed;
    right: 0;
    top: 0;
    transition: opacity 180ms ease;
    z-index: 45;
  }

  .is-mobile-sidebar-open .sidebar-overlay {
    display: block;
    opacity: 1;
    pointer-events: auto;
  }

  .sidebar-mobile-close,
.sidebar-menu-button {
    display: inline-flex;
  }

  .sidebar-collapse-button {
    display: none;
  }

  .is-sidebar-collapsed .sidebar {
    padding: 18px;
  }

  .is-sidebar-collapsed .sidebar .brand-lockup {
    justify-content: flex-start;
  }

  .is-sidebar-collapsed .sidebar .brand-lockup div,
.is-sidebar-collapsed .nav-item span {
    display: block;
  }

  .is-sidebar-collapsed .nav-item {
    justify-content: flex-start;
    padding: 0 12px;
  }

  .sidebar .brand-lockup {
    margin-bottom: 18px;
  }

  .nav-list {
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }

  .app-shell--module .topbar .brand-lockup {
    display: none;
  }

  .topbar__identity {
    margin-left: 0;
  }

  .flow-strip,
.operations-band {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ets-folder-tabs {
    align-items: stretch;
    display: grid;
    grid-template-columns: 1fr;
  }

  .ets-folder-tab,
.ets-folder-tab.is-active {
    border-radius: 8px;
    min-height: 42px;
    transform: none;
  }

  .ets-timeline-item {
    grid-template-columns: 1fr;
  }

  .client-form {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .client-form--modal {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .clients-table {
    overflow-x: auto;
    padding-bottom: 6px;
  }

  .clients-table__head,
.clients-table__row {
    min-width: 980px;
  }

  .quotations-table .clients-table__head,
.quotations-table .clients-table__row {
    min-width: 1120px;
  }

  .products-table .clients-table__head,
.products-table .clients-table__row {
    min-width: 1240px;
  }

  .service-orders-table .clients-table__head,
.service-orders-table .clients-table__row,
.equipment-table .clients-table__head,
.equipment-table .clients-table__row,
.ets-certificates-table .clients-table__head,
.ets-certificates-table .clients-table__row,
.certificates-table .clients-table__head,
.certificates-table .clients-table__row,
.pending-certificates-table .clients-table__head,
.pending-certificates-table .clients-table__row,
.quality-table .clients-table__head,
.quality-table .clients-table__row,
.audit-log-table .clients-table__head,
.audit-log-table .clients-table__row {
    min-width: 1320px;
  }

  .catalog-filters,
.import-template-grid,
.quotation-commercial-grid,
.service-order-info-grid,
.glass-card-mini,
.field-sheet-form-grid,
.read-only-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 680px) {
  .auth-screen {
    align-items: stretch;
    padding: 14px;
  }

  .auth-panel {
    margin: auto 0;
    padding: 22px;
  }

  .workspace {
    padding: 18px;
  }

  .topbar {
    align-items: flex-start;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
  }

  .workspace-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .workspace-header__summary {
    text-align: left;
    width: 100%;
  }

  .flow-strip,
.modules-grid,
.operations-band {
    grid-template-columns: 1fr;
  }

  .section-heading {
    flex-direction: column;
  }

  .client-form {
    grid-template-columns: 1fr;
  }

  .client-form--modal {
    grid-template-columns: 1fr;
  }

  .client-modal-tabs {
    grid-template-columns: 1fr;
  }

  .module-tabs,
.catalog-filters,
.clients-filters,
.import-template-grid,
.import-upload-zone,
.import-upload-zone--clients,
.quotation-sheet__meta,
.quotation-sheet__grid {
    grid-template-columns: 1fr;
  }

  .toolbar-actions {
    align-items: stretch;
    width: 100%;
  }

  .toolbar-actions .table-button,
.toolbar-actions .primary-button {
    width: 100%;
  }

  .modal-backdrop {
    align-items: stretch;
    padding: 12px;
  }

  .client-modal {
    max-height: calc(100vh - 24px);
    padding: 18px;
  }

  .service-order-modal {
    max-height: calc(100vh - 24px);
    max-height: calc(100dvh - 24px);
    width: 100%;
  }

  .client-form__actions--modal {
    align-items: stretch;
    flex-direction: column-reverse;
  }

  .quotation-summary,
.quotation-commercial-grid {
    grid-template-columns: 1fr;
  }

  .quotation-actions {
    flex-direction: column;
  }

  .quotation-detail-header,
.quotation-sheet__header {
    align-items: center;
    grid-template-columns: 1fr;
    flex-direction: column;
  }

  .quotation-sheet__brand {
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .quotation-sheet__meta {
    text-align: left;
  }

  .quotation-sheet__meta--four,
.template-editor-grid {
    grid-template-columns: 1fr;
  }

  .quotation-sheet__title-block {
    padding: 0 !important;
  }

  .quotation-sheet__document-control {
    margin: 0 auto 12px;
    position: static;
    transform: none;
    width: min(100%, 190px);
  }

  .quotation-lines-preview {
    overflow-x: auto;
  }

  .quotation-items-table {
    overflow-x: auto;
  }

  .quotation-lines-preview__head,
.quotation-lines-preview__row,
.quotation-items-table__head,
.quotation-items-table__row {
    min-width: 760px;
  }

  .module-card {
    min-height: 190px;
  }

  .module-workspace__hero {
    align-items: flex-start;
    flex-direction: column;
  }

  .module-workspace__time {
    margin-left: 0;
    text-align: left;
    width: 100%;
  }
}

/* ==========================================
   CONFIGURACION
========================================== */

.settings-panel {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.settings-tabs {
  display: flex;
  gap: 10px;
  margin-bottom: 24px;
}

.settings-tab {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(8, 51, 68, 0.1);
  border-radius: 999px;
  color: #0f172a;
  font-size: 0.95rem;
  font-weight: 700;
  min-height: 40px;
  padding: 0 16px;
}

.settings-tab.is-active {
  background: linear-gradient(135deg, var(--myc-primary), #099d91);
  color: #ffffff;
}

.settings-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.settings-toolbar h2 {
  margin: 0;
  font-size: 1.2rem;
}

.settings-table {
  width: 100%;
  border-collapse: collapse;
}

.settings-table thead {
  background: rgba(255,255,255,0.08);
}

.settings-table th {
  padding: 14px;
  text-align: left;
  font-weight: 700;
  color: #083344;
}

.settings-table td {
  padding: 14px;
  border-top: 1px solid rgba(255,255,255,0.15);
}

.settings-table tbody tr {
  transition: all 0.25s ease;
}

.settings-table tbody tr:hover {
  background: rgba(255,255,255,0.08);
}

.settings-role-select {
  width: 100%;
  min-width: 180px;
  padding: 8px 12px;
  border-radius: 10px;
  border: 1px solid rgba(0,0,0,0.1);
  background: white;
  font-size: 0.95rem;
}

.settings-action-button {
  padding: 8px 14px;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.25s ease;
}

.settings-action-button:hover {
  transform: translateY(-2px);
}

.settings-action-button.activate {
  background: #16a34a;
  color: white;
}

.settings-action-button.deactivate {
  background: #dc2626;
  color: white;
}

.settings-status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
}

.settings-status::before {
  content: "";
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.settings-status.active::before {
  background: #22c55e;
}

.settings-status.inactive::before {
  background: #ef4444;
}

.settings-card {
  background: rgba(255,255,255,0.12);
  backdrop-filter: blur(12px);
  border-radius: 18px;
  padding: 20px;
  border: 1px solid rgba(255,255,255,0.15);
  box-shadow: 0 10px 30px rgba(0,0,0,0.08);
}

.secondary-button {
  align-items: center;
  background: rgba(255, 255, 255, 0.88);
  border: 1px solid rgba(8, 51, 68, 0.12);
  border-radius: 6px;
  color: #083344;
  display: inline-flex;
  font-weight: 700;
  justify-content: center;
  min-height: 42px;
  padding: 0 18px;
}

.settings-users-table__row {
  cursor: pointer;
}

.settings-users-table__row:focus-visible {
  outline: 2px solid rgba(15, 118, 110, 0.35);
  outline-offset: -2px;
}

.settings-user-modal {
  max-width: 720px;
}

.settings-user-modal--complete { height: min(820px, 92vh); max-width: 1040px; overflow: hidden; width: min(1040px, 96vw); }
.settings-user-modal__body { min-height: 0; overflow-y: auto; padding: 4px 6px 18px; }
.settings-user-tabs { flex-wrap: wrap; margin-bottom: 18px; }
.settings-user-grid,
.settings-detail-grid,
.portal-configuration-form { display: grid; gap: 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.settings-detail-grid > span,
.portal-client-comparison > span { background: rgba(240,253,250,.72); border: 1px solid rgba(15,118,110,.12); border-radius: 12px; display: flex; flex-direction: column; gap: 5px; padding: 14px; }
.settings-detail-grid small,
.portal-client-comparison small { color: #64748b; }
.settings-role-checklist { display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.settings-role-checklist--compact { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
.settings-role-checklist .settings-checkbox { align-items: flex-start; border: 1px solid rgba(15,118,110,.12); border-radius: 10px; padding: 12px; }
.settings-role-checklist .settings-checkbox span { display: flex; flex-direction: column; gap: 3px; }
.settings-role-checklist small { color: #64748b; font-weight: 500; }
.settings-chip-list { display: flex; flex-wrap: wrap; gap: 6px; }
.settings-chip-list > span { background: #ccfbf1; border-radius: 999px; color: #115e59; font-size: .76rem; font-weight: 700; padding: 4px 9px; }
.settings-activity-list { display: grid; gap: 9px; }
.settings-activity-list article { border-bottom: 1px solid rgba(15,118,110,.12); display: grid; gap: 3px; padding: 10px; }
.settings-account-toolbar { display: grid; gap: 12px; grid-template-columns: 1fr minmax(220px, 300px); margin: 18px 0; }
.settings-account-table .clients-table__head,
.settings-account-table .clients-table__row { grid-template-columns: 1.35fr .55fr .8fr 1fr 1fr; }
.settings-account-table .clients-table__row > span { align-items: flex-start; display: flex; flex-direction: column; gap: 5px; }
.settings-pagination { align-items: center; display: flex; gap: 14px; justify-content: flex-end; margin-top: 16px; }
.portal-client-comparison { display: grid; gap: 10px; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 14px 0; }
.portal-summary-card--global { border-color: rgba(245,158,11,.35); }
.portal-summary-card em { color: #92400e; font-size: .7rem; font-style: normal; }
.portal-operation-tabs { flex-wrap: wrap; margin: 20px 0; }
.portal-operation-list { display: grid; gap: 12px; }
.portal-operation-card { align-items: flex-start; background: rgba(255,255,255,.78); border: 1px solid rgba(15,118,110,.14); border-radius: 14px; display: flex; gap: 16px; justify-content: space-between; padding: 16px; }
.portal-operation-card > div { display: flex; flex-direction: column; gap: 6px; }
.portal-operation-card details { max-width: 520px; width: 48%; }
.portal-operation-card summary { color: #0f766e; cursor: pointer; font-weight: 700; margin-bottom: 10px; }
.settings-inline-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
.settings-inline-actions button,
.portal-user-actions button { background: white; border: 1px solid rgba(15,118,110,.2); border-radius: 8px; color: #0f766e; padding: 8px 11px; }
.portal-operation-form { align-items: end; background: rgba(240,253,250,.6); border-radius: 14px; display: grid; gap: 14px; grid-template-columns: repeat(3, minmax(0,1fr)); margin-bottom: 18px; padding: 16px; }
.portal-operation-form label,
.portal-configuration-form label,
.portal-user-invite label { display: flex; flex-direction: column; font-weight: 700; gap: 6px; }
.portal-operation-form input,
.portal-operation-form select,
.portal-operation-form textarea,
.portal-configuration-form input,
.portal-configuration-form select,
.portal-configuration-form textarea,
.portal-user-invite input { border: 1px solid rgba(15,118,110,.18); border-radius: 9px; min-height: 42px; padding: 9px 11px; }
.portal-configuration-form { padding: 8px 0; }
.form-field--wide { grid-column: 1 / -1; }
.settings-checkbox.is-disabled { opacity: .58; }
.portal-user-invite { background: white; border-radius: 14px; display: grid; gap: 14px; grid-template-columns: repeat(2,minmax(0,1fr)); margin-bottom: 22px; padding: 18px; }
.portal-role-options { display: flex; flex-wrap: wrap; gap: 10px; grid-column: 1 / -1; }
.portal-user-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.portal-invitation-summary { margin-top: 24px; }

@media (max-width: 900px) {
  .portal-client-comparison { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .settings-account-table .clients-table__head { display: none; }
  .settings-account-table .clients-table__row { grid-template-columns: 1fr; }
  .portal-operation-card { flex-direction: column; }
  .portal-operation-card details { max-width: none; width: 100%; }
}

@media (max-width: 640px) {
  .settings-user-grid,
.settings-detail-grid,
.settings-role-checklist,
.portal-configuration-form,
.portal-operation-form,
.portal-user-invite,
.settings-account-toolbar { grid-template-columns: 1fr; }
  .portal-client-comparison { grid-template-columns: 1fr; }
}

.settings-user-modal__header {
  align-items: flex-start;
  margin-bottom: 20px;
}

.settings-user-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.settings-filters {
  align-items: end;
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(4, minmax(0, 1fr)) auto;
}

.settings-filters__actions {
  display: flex;
  gap: 10px;
}

.field-label {
  color: #083344;
  display: flex;
  flex-direction: column;
  font-size: 0.92rem;
  font-weight: 700;
  gap: 8px;
}

.text-input {
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid rgba(15, 118, 110, 0.16);
  border-radius: 10px;
  color: #0f172a;
  min-height: 44px;
  padding: 0 14px;
}

.text-input:focus {
  border-color: var(--myc-primary);
  box-shadow: 0 0 0 3px rgba(53, 208, 186, 0.18);
  outline: none;
}

.settings-checkbox {
  align-items: center;
  color: #083344;
  display: inline-flex;
  gap: 10px;
  font-weight: 700;
}

.settings-checkbox input {
  accent-color: var(--myc-primary);
}

.settings-audit-badge {
  background: rgba(15, 118, 110, 0.12);
  border: 1px solid rgba(15, 118, 110, 0.14);
  border-radius: 999px;
  color: var(--myc-primary-dark);
  display: inline-flex;
  font-size: 0.8rem;
  font-weight: 800;
  padding: 4px 10px;
}

.settings-audit-summary {
  color: #0f172a;
  line-height: 1.45;
}

.confirm-dialog {
  max-width: 560px;
}

.confirm-dialog__header {
  margin-bottom: 18px;
}

.confirm-dialog__body p {
  color: var(--myc-soft-text);
  font-size: 14px;
  font-weight: 760;
  line-height: 1.55;
  margin: 0;
  white-space: pre-wrap;
}

.confirm-dialog__actions {
  margin-top: 24px;
}

.danger-zone {
  background: rgba(254, 242, 242, 0.52);
  border: 1px solid rgba(220, 38, 38, 0.16);
  border-radius: 8px;
  display: grid;
  gap: 14px;
  margin-top: 20px;
  padding: 16px;
}

.danger-zone__copy {
  display: grid;
  gap: 4px;
}

.danger-zone__copy p {
  color: #991b1b;
  font-size: 12.5px;
  font-weight: 850;
  margin: 0;
  text-transform: uppercase;
}

.danger-zone__copy span {
  color: #7f1d1d;
  font-size: 13px;
  font-weight: 720;
  line-height: 1.5;
}

/* ==========================================
   Barra de acción
========================================== */

.selection-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin: 14px 0;
  padding: 12px 14px;
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 18px;
  background: rgba(236, 255, 252, 0.72);
  backdrop-filter: blur(18px);
  box-shadow: 0 18px 40px rgba(0, 42, 52, 0.14);
}

.selection-action-bar__info {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #07333a;
}

.selection-action-bar__actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.table-row--selected {
  background: rgba(14, 165, 160, 0.18) !important;
  outline: 2px solid rgba(14, 165, 160, 0.45);
  outline-offset: -2px;
}

.row-selector {
  width: 18px;
  height: 18px;
  accent-color: var(--myc-primary);
  cursor: pointer;
}

@media (max-width: 720px) {
  .selection-action-bar {
    align-items: stretch;
    flex-direction: column;
  }

  .selection-action-bar__info,
.selection-action-bar__actions {
    justify-content: space-between;
  }
}

.confirm-dialog__actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 24px;
}

.confirm-dialog__actions button {
  min-height: 44px;
  padding: 11px 18px;
  border-radius: 14px;
  border: 1px solid transparent;
  font-size: 14px;
  font-weight: 900;
  cursor: pointer;
}

.confirm-dialog__cancel {
  background: rgba(255, 255, 255, 0.78);
  border-color: rgba(6, 52, 60, 0.16);
  color: #07343b;
}

.confirm-dialog__confirm {
  background: linear-gradient(135deg, #0fafa7, #0d9488);
  border-color: rgba(13, 148, 136, 0.32);
  color: white;
}

.confirm-dialog__confirm--danger {
  background: linear-gradient(135deg, #fee2e2, #fecaca);
  border-color: rgba(220, 38, 38, 0.32);
  color: #991b1b;
}

.selection-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin: 16px 0;
  padding: 14px 16px;
  border: 1px solid rgba(187, 255, 247, 0.55);
  border-radius: 18px;
  background: rgba(224, 255, 251, 0.78);
  backdrop-filter: blur(18px);
}

.selection-action-bar__info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.selection-action-bar__info strong {
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.55);
  color: #07343b;
}

.selection-action-bar__actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.selection-action-bar .ghost-button {
  min-height: 38px;
  padding: 9px 14px;
  border-radius: 12px;
  border: 1px solid rgba(6, 52, 60, 0.16);
  background: rgba(255, 255, 255, 0.62);
  color: #07343b;
  font-weight: 800;
}

.selection-action-bar .table-button {
  min-height: 38px;
  padding: 9px 14px;
  border-radius: 12px;
  font-weight: 800;
}

.table-row--selected {
  background: rgba(12, 171, 164, 0.18) !important;
  outline: 2px solid rgba(12, 171, 164, 0.42);
  outline-offset: -2px;
}

.row-selector {
  width: 18px;
  height: 18px;
  accent-color: var(--myc-primary);
  cursor: pointer;
}

/* configuraciones auditoria */

/* configuraciones auditoria */

.audit-log-table {
  display: grid;
  gap: 8px;
  margin-top: 18px;
}

.audit-log-table__head,
.audit-log-table__row {
  display: grid;
  grid-template-columns: 170px 150px 180px 130px 90px minmax(360px, 1fr);
  gap: 14px;
  align-items: center;
}

.audit-log-table__head {
  padding: 0 14px 8px;
  color: #06343c;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
}

.audit-log-table__row {
  min-height: 58px;
  padding: 12px 14px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.34);
  cursor: pointer;
  transition: 0.2s ease;
}

.audit-log-table__row:hover {
  background: rgba(224, 255, 251, 0.65);
  transform: translateY(-1px);
}

.audit-log-table__row > span {
  min-width: 0;
  overflow-wrap: anywhere;
}

.audit-log-empty {
  padding: 18px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.35);
  text-align: center;
  color: #07343b;
  font-weight: 700;
}

.settings-audit-badge {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  max-width: 100%;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(12, 171, 164, 0.16);
  color: #064e4b;
  font-size: 12px;
  font-weight: 900;
  white-space: nowrap;
}

.settings-audit-summary {
  display: block;
  color: #07343b;
  font-size: 13px;
  line-height: 1.35;
  word-break: break-word;
}

.audit-detail-modal {
  max-width: 980px;
}

.audit-detail-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin: 18px 0;
}

.audit-detail-grid article {
  padding: 14px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.58);
  border: 1px solid rgba(255, 255, 255, 0.55);
}

.audit-detail-grid span {
  display: block;
  margin-bottom: 6px;
  color: #64748b;
  font-size: 12px;
  font-weight: 800;
}

.audit-detail-grid strong {
  color: #07343b;
  font-size: 14px;
}

.audit-detail-values {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.audit-detail-values article {
  border-radius: 18px;
  padding: 14px;
  background: rgba(7, 52, 59, 0.92);
  color: white;
  overflow: hidden;
}

.audit-detail-values h3 {
  margin: 0 0 10px;
  color: white;
}

.audit-detail-values pre {
  max-height: 320px;
  overflow: auto;
  margin: 0;
  font-size: 12px;
  line-height: 1.5;
  white-space: pre-wrap;
}

@media (max-width: 1100px) {
  .audit-log-table__head,
.audit-log-table__row {
    grid-template-columns: 150px 130px 160px 110px 80px minmax(280px, 1fr);
  }
}

@media (max-width: 850px) {
  .audit-log-table__head {
    display: none;
  }

  .audit-log-table__row {
    grid-template-columns: 1fr;
    gap: 8px;
  }
}

@media (max-width: 820px) {
  .audit-detail-grid,
.audit-detail-values {
    grid-template-columns: 1fr;
  }
}

.standards-detail-modal {
  width: min(1180px, calc(100vw - 64px));
  max-height: calc(100vh - 64px);
  overflow-y: auto;
  padding: 28px;
}

.standards-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24px;
  padding: 0 0 18px;
  margin: 0 0 22px;
  background: transparent;
  border-bottom: 1px solid rgba(7, 78, 94, 0.15);
}

.standards-header__caption {
  display: block;
  margin-bottom: 6px;
  font-size: 0.78rem;
  font-weight: 900;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--myc-primary);
}

.standards-header h2 {
  margin: 0;
  font-size: 2rem;
  font-weight: 900;
  color: #072936;
}

.standards-header__meta {
  margin: 8px 0 0;
  font-size: 0.95rem;
  font-weight: 600;
  color: #5f6f75;
}

.standards-header .quotation-detail-summary {
  flex-shrink: 0;
}

.standards-detail-modal .module-tabs {
  margin-bottom: 20px;
}

.standards-detail-modal .field-sheet-form-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px 16px;
}

.standards-detail-modal .field-sheet-form-grid label {
  font-size: 0.78rem;
  font-weight: 800;
  color: #07313a;
  letter-spacing: 0.02em;
}

.standards-detail-modal input,
.standards-detail-modal select,
.standards-detail-modal textarea {
  margin-top: 6px;
  min-height: 42px;
  font-size: 0.92rem;
  font-weight: 600;
}

.standards-detail-modal .form-field--wide,
.standards-detail-modal .quotation-detail-save {
  grid-column: 1 / -1;
}

.standards-detail-modal .quotation-section {
  padding: 20px;
  margin-top: 0;
}

.standards-detail-modal .quotation-section__title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}

.standards-detail-modal .quotation-section__title h3 {
  display: none;
}

.standards-detail-modal .quotation-section__title p {
  margin: 0;
  color: var(--myc-primary);
  font-size: 0.76rem;
  font-weight: 900;
  text-transform: uppercase;
}

@media (max-width: 980px) {
  .standards-detail-modal {
    width: calc(100vw - 28px);
    max-height: calc(100vh - 28px);
    padding: 20px;
  }

  .standards-header {
    flex-direction: column;
    gap: 14px;
  }

  .standards-detail-modal .field-sheet-form-grid {
    grid-template-columns: 1fr;
  }
}
.standards-detail-modal .detail-modal__close {
  position: absolute;
  top: 18px;
  right: 18px;
  z-index: 10;
}
.standards-header .quotation-detail-summary {
  min-width: 230px;
  padding: 14px 16px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.42);
  border: 1px solid rgba(255, 255, 255, 0.48);
  display: flex;
  flex-direction: column;
  gap: 5px;
  text-align: right;
}

.standards-header .quotation-detail-summary span {
  font-size: 0.72rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--myc-primary);
}

.standards-header .quotation-detail-summary strong {
  display: block;
  font-size: 1rem;
  font-weight: 900;
  color: #082c39;
}

.standards-header .quotation-detail-summary small {
  display: block;
  font-size: 0.78rem;
  font-weight: 700;
  color: #5f6f75;
}

.standards-detail-modal .detail-modal__close {
  position: absolute;
  top: 18px;
  right: 18px;
  z-index: 10;
}

/* ==========================================
   Navegador compacto de modal de clientes
========================================== */

.client-modal-header {
  align-items: flex-start;
  display: flex;
  gap: 16px;
  justify-content: space-between;
  margin-bottom: 16px;
}

.client-modal-header p {
  color: var(--myc-primary);
  font-size: 13.5px;
  font-weight: 850;
  margin: 0 0 5px;
  text-transform: uppercase;
}

.client-modal-header h2 {
  color: var(--myc-navy);
  font-size: 22px;
  font-weight: 850;
  line-height: 1.2;
  margin: 0;
}

.client-modal-header span {
  color: #0f766e;
  display: block;
  font-size: 12.5px;
  font-weight: 850;
  margin-top: 4px;
}

.client-modal-navigator {
  align-items: center;
  background: rgba(255, 255, 255, 0.34);
  border: 1px solid rgba(201, 255, 247, 0.44);
  border-radius: 999px;
  display: inline-flex;
  flex: 0 0 auto;
  gap: 6px;
  min-height: 34px;
  padding: 4px;
}

.client-modal-navigator button {
  align-items: center;
  background: rgba(255, 255, 255, 0.58);
  border: 1px solid rgba(8, 117, 111, 0.14);
  border-radius: 999px;
  color: var(--myc-primary-dark);
  display: inline-flex;
  font-size: 12px;
  font-weight: 900;
  height: 26px;
  justify-content: center;
  min-width: 26px;
  padding: 0 8px;
}

.client-modal-navigator button:hover:not(:disabled) {
  background: rgba(232, 250, 247, 0.86);
  border-color: rgba(8, 117, 111, 0.28);
}

.client-modal-navigator button:focus-visible {
  box-shadow: 0 0 0 3px rgba(70, 216, 196, 0.22);
  outline: 2px solid var(--myc-primary);
  outline-offset: 2px;
}

.client-modal-navigator button:disabled {
  cursor: not-allowed;
  opacity: 0.48;
}

.client-modal-navigator strong {
  color: var(--myc-primary-dark);
  font-size: 12px;
  font-weight: 900;
  min-width: 64px;
  text-align: center;
  white-space: nowrap;
}

@media (max-width: 680px) {
  .client-modal-header {
    align-items: stretch;
    flex-direction: column;
  }

  .client-modal-navigator {
    justify-content: flex-end;
    width: fit-content;
  }
}


/* ==========================================
   Paginación de clientes
========================================== */

.clients-pagination {
  align-items: center;
  background: rgba(255, 255, 255, 0.26);
  border: 1px solid rgba(201, 255, 247, 0.34);
  border-radius: 8px;
  display: flex;
  gap: 14px;
  justify-content: space-between;
  margin-top: 14px;
  padding: 12px;
}

.clients-pagination > span {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 850;
}

.clients-pagination__controls {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  justify-content: flex-end;
}

.clients-pagination__controls .table-button {
  min-width: 34px;
}

.clients-pagination__controls small {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 900;
  padding: 0 3px;
}

@media (max-width: 680px) {
  .clients-pagination {
    align-items: stretch;
    flex-direction: column;
  }

  .clients-pagination__controls {
    justify-content: flex-start;
  }
}

/* ===========================
   Selector de cliente (Cotizaciones)
   =========================== */

.quotation-client-picker {
  max-width: 720px;
}

.quotation-client-search {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  margin: 1rem 0;
  font-weight: 700;
  color: #08353d;
}

.quotation-client-search input {
  width: 100%;
  padding: 0.85rem 1rem;
  border-radius: 14px;
  border: 1px solid rgba(12, 171, 164, 0.25);
  background: rgba(255, 255, 255, 0.82);
  color: #08353d;
  font-size: 0.95rem;
  transition: all .2s ease;
}

.quotation-client-search input input:focus {
  outline: none;
  border-color: rgba(12,171,164,.8);
  box-shadow: 0 0 0 3px rgba(12,171,164,.18);
}

.quotation-client-results {
  display: flex;
  flex-direction: column;
  gap: .75rem;
  max-height: 420px;
  overflow-y: auto;
  padding-right: .35rem;
}

.quotation-client-result {
  width: 100%;
  text-align: left;
  border: 1px solid rgba(12,171,164,.18);
  border-radius: 16px;
  padding: 1rem;
  background: rgba(255,255,255,.55);
  cursor: pointer;
  transition: all .18s ease;
}

.quotation-client-result:hover {
  border-color: rgba(12,171,164,.55);
  background: rgba(12,171,164,.10);
  transform: translateY(-1px);
}

.quotation-client-result strong {
  display: block;
  font-size: 1rem;
  color: #08353d;
}

.quotation-client-result span {
  display: block;
  margin-top: .25rem;
  font-size: .9rem;
  color: #4d5d63;
}

.quotation-client-result small {
  display: block;
  margin-top: .45rem;
  color: #6d7b82;
}

.ets-work-orders-modal {
  backdrop-filter: blur(22px) saturate(150%);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.56), rgba(70, 216, 196, 0.16)),
    rgba(255, 255, 255, 0.36);
  border: 1px solid rgba(201, 255, 247, 0.62);
  border-radius: 8px;
  box-shadow: 0 34px 90px rgba(5, 31, 45, 0.32);
  max-height: min(720px, calc(100vh - 44px));
  max-width: 760px;
  overflow: auto;
  padding: 22px;
  position: relative;
  width: min(760px, 100%);
}

.ets-work-orders-modal::before {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.86), rgba(70, 216, 196, 0.24), transparent);
  content: "";
  height: 1px;
  left: 16px;
  position: absolute;
  right: 16px;
  top: 10px;
}

.ets-work-orders-list {
  display: grid;
  gap: 10px;
  margin-top: 14px;
}

.ets-work-order-row {
  align-items: center;
  background: rgba(255, 255, 255, 0.42);
  border: 1px solid rgba(201, 255, 247, 0.42);
  border-radius: 8px;
  color: var(--myc-text);
  display: flex;
  justify-content: space-between;
  min-height: 68px;
  padding: 12px 14px;
  text-align: left;
  transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
  width: 100%;
}

.ets-work-order-row:hover {
  border-color: rgba(22, 148, 140, 0.5);
  box-shadow: 0 12px 24px rgba(9, 44, 54, 0.12);
  transform: translateY(-1px);
}

.ets-work-order-row strong {
  color: var(--myc-navy);
  display: block;
  font-size: 16px;
  font-weight: 900;
}

.ets-work-order-row span {
  color: var(--myc-soft-text);
  font-size: 13px;
  font-weight: 780;
}

.ets-work-order-row__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: flex-end;
}

.ets-work-order-row__actions .is-danger {
  border-color: rgba(180, 35, 24, 0.35);
  color: #b42318;
}

.ets-work-orders-modal .form-field {
  display: grid;
  gap: 7px;
  margin-top: 14px;
}

.ets-work-orders-modal .form-field label {
  color: var(--myc-soft-text);
  font-size: 12px;
  font-weight: 850;
  text-transform: uppercase;
}

.ets-work-orders-modal .form-field input {
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(8, 117, 111, 0.18);
  border-radius: 8px;
  color: var(--myc-text);
  font-size: 14px;
  font-weight: 780;
  min-height: 40px;
  padding: 0 12px;
  width: 100%;
}

@media (max-width: 680px) {
  .ets-work-order-row {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
  }

  .ets-signature-launcher,
.ets-signature-flow__header {
    align-items: stretch;
    flex-direction: column;
  }

  .ets-signature-launcher {
    padding: 14px;
  }

  .ets-signature-launcher .signature-morph-button {
    align-self: flex-start;
  }
}

.modal-header .ghost-button {
  min-height: 38px;
  padding: 9px 14px;
  border-radius: 12px;
  border: 1px solid rgba(6, 52, 60, 0.16);
  background: rgba(255,255,255,.62);
  color: #07343b;
  font-weight: 800;
  cursor: pointer;
}

.modal-header .ghost-button:hover {
  background: rgba(255,255,255,.82);
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  margin-bottom: 18px;
}

.modal-header-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.modal-header .ghost-button {
  flex-shrink: 0;
}

.signature-wrapper {
  position: relative;
  width: 72%;
  height: 42px;
  margin: 0 auto 2px;
}

.signature-line {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  border-bottom: 1px solid #0070c0;
  height: 1px;
}

.signature-image {
  position: absolute;
  left: 50%;
  bottom: 2px;
  transform: translateX(-50%);
  max-width: 95%;
  max-height: 38px;
  object-fit: contain;
}

.signature-name {
  margin-top: 3px;
  font-size: 5.4px;
  font-weight: 700;
}

/* ==========================================
   Modal compacto de equipos ETS
========================================== */

.ets-equipment-form-modal {
  max-height: min(680px, calc(100vh - 44px));
  max-width: 720px;
  padding: 18px 20px;
  width: min(720px, 100%);
}

.ets-equipment-form-modal .section-heading {
  margin-bottom: 10px;
}

.ets-equipment-form-modal .section-heading p {
  margin-bottom: 3px;
}

.ets-equipment-form-modal .section-heading h2 {
  font-size: 20px;
}

.ets-equipment-form-modal .client-form--modal {
  gap: 10px 12px;
}

.ets-equipment-form-modal .client-form label {
  font-size: 13px;
  gap: 5px;
}

.ets-equipment-form-modal .client-form input,
.ets-equipment-form-modal .client-form select {
  min-height: 36px;
  padding: 0 10px;
}

.ets-equipment-form-modal .client-form textarea {
  min-height: 68px;
  padding: 8px 10px;
}

.ets-equipment-form-modal .ets-certificate-capacity-list {
  gap: 6px;
}

.ets-equipment-form-modal .ets-certificate-capacity-list article {
  min-height: 36px;
  padding: 7px 10px;
}

.ets-equipment-form-modal .ets-certificate-capacity-list span {
  font-size: 12px;
}

.ets-equipment-form-modal .ets-certificate-capacity-list strong {
  font-size: 15px;
}

.ets-equipment-form-modal .ets-condition-presets {
  gap: 6px;
  margin: 3px 0;
}

.ets-equipment-form-modal .ets-condition-presets .table-button {
  min-height: 30px;
  font-size: 12px;
}

.ets-equipment-form-modal .client-form__actions--modal {
  margin-top: 2px;
}

@media (max-width: 680px) {
  .ets-equipment-form-modal {
    max-height: calc(100vh - 24px);
    padding: 16px;
    width: 100%;
  }
}
.ets-equipment-form-modal .client-form--modal {
  align-items: start;
  gap: 10px 12px;
}

.ets-equipment-form-modal .client-form--modal > label,
.ets-equipment-form-modal .client-form--modal > div {
  align-self: start;
}

.ets-equipment-form-modal .client-form label {
  align-content: start;
  font-size: 13px;
  gap: 5px;
}

.ets-equipment-form-modal .client-form input,
.ets-equipment-form-modal .client-form select {
  height: 36px;
  min-height: 36px;
  padding: 0 10px;
}

.ets-equipment-form-modal .client-form textarea {
  height: 68px;
  min-height: 68px;
  padding: 8px 10px;
}

/* Control Documental */
.document-control-workspace { gap: 18px; }
.document-control-hero { min-height: 150px; }
.document-control-hero .primary-button { margin-left: auto; flex: 0 0 auto; }
.document-control-summary { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.document-catalog-panel { display: grid; gap: 16px; padding: 20px; }
.document-catalog-heading { align-items: end; gap: 18px; margin: 0; }
.document-catalog-heading > div:first-child span { color: var(--myc-soft-text); display: block; font-size: 13px; font-weight: 720; margin-top: 5px; }
.document-subnav { align-items: center; background: rgba(255, 255, 255, .32); border: 1px solid rgba(8, 117, 111, .14); border-radius: 12px; box-shadow: 0 10px 28px rgba(5, 31, 45, .06); display: flex; gap: 12px; justify-content: space-between; padding: 7px; }
.document-subnav__tabs { align-items: center; display: flex; flex-wrap: wrap; gap: 6px; }
.document-subnav__tabs button { background: transparent; border: 1px solid transparent; border-radius: 8px; color: var(--myc-soft-text); font: inherit; font-size: 13px; font-weight: 850; min-height: 38px; padding: 0 14px; }
.document-subnav__tabs button:hover,
.document-subnav__tabs button:focus-visible { background: rgba(232, 250, 247, .62); border-color: rgba(8, 117, 111, .2); color: var(--myc-primary-dark); outline: none; }
.document-subnav__tabs button.is-active { background: linear-gradient(135deg, rgba(70, 216, 196, .32), rgba(232, 250, 247, .82)); border-color: rgba(8, 117, 111, .28); box-shadow: inset 0 1px 0 rgba(255,255,255,.65), 0 5px 14px rgba(5,31,45,.08); color: var(--myc-primary-dark); }
.document-subnav__action { flex: 0 0 auto; min-height: 38px; }
.document-catalog-filters { align-items: center; display: grid; gap: 8px; grid-template-columns: minmax(260px, 1.6fr) minmax(150px, .7fr) minmax(180px, .8fr); width: min(780px, 100%); }
.document-catalog-filters input,
.document-catalog-filters select,
.document-form-grid input,
.document-form-grid select,
.document-form-grid textarea {
  background: rgba(255, 255, 255, .66);
  border: 1px solid rgba(8, 117, 111, .18);
  border-radius: 8px;
  color: var(--myc-text);
  font: inherit;
  min-height: 42px;
  padding: 9px 12px;
  width: 100%;
}
.document-search { align-items: center; display: flex; position: relative; }
.document-search svg { color: var(--myc-primary); left: 12px; pointer-events: none; position: absolute; }
.document-search input { padding-left: 38px; }
.document-catalog-table { overflow-x: auto; }
.document-catalog-table .clients-table__head { background: rgba(8, 117, 111, .1); border-color: rgba(8, 117, 111, .18); color: var(--myc-primary-dark); }
.document-catalog-grid { grid-template-columns: .72fr 1.7fr .9fr .76fr 1fr .9fr .55fr; min-width: 940px; }
.document-catalog-row { background: rgba(255,255,255,.38); cursor: pointer; min-height: 62px; padding-block: 12px; transition: background .18s ease, border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
.document-catalog-row:hover,
.document-catalog-row:focus-visible,
.document-catalog-row.is-selected { background: rgba(232, 250, 247, .72); border-color: rgba(8, 117, 111, .36); box-shadow: 0 12px 26px rgba(5, 31, 45, .08); outline: none; }
.document-catalog-row:active { transform: translateY(0); }
.document-filter-context { align-items: center; background: rgba(70, 216, 196, .12); border: 1px solid rgba(8, 117, 111, .16); border-radius: 7px; color: var(--myc-primary-dark); display: flex; font-size: 13px; font-weight: 800; min-height: 42px; padding: 0 12px; }
.document-name-cell { display: grid; gap: 4px; min-width: 190px; }
.document-name-cell small { color: var(--myc-soft-text); font-size: 11.5px; font-weight: 700; }
.document-type-mark { align-items: center; color: var(--myc-soft-text); display: inline-flex; font-size: 11.5px; font-weight: 800; gap: 7px; white-space: nowrap; }
.document-type-mark i { background: #6b8790; border-radius: 999px; box-shadow: 0 0 0 3px rgba(107, 135, 144, .12); display: inline-block; height: 7px; width: 7px; }
.document-type-mark--procedure i { background: #218c78; box-shadow: 0 0 0 3px rgba(33, 140, 120, .12); }
.document-type-mark--format i,
.document-type-mark--field_sheet_template i,
.document-type-mark--quotation_template i,
.document-type-mark--work_order_template i { background: #3184a8; box-shadow: 0 0 0 3px rgba(49, 132, 168, .12); }
.document-type-mark--manual i,
.document-type-mark--policy i { background: #796aa6; box-shadow: 0 0 0 3px rgba(121, 106, 166, .12); }
.document-type-mark--record i,
.document-type-mark--certificate_master i { background: #b97a3c; box-shadow: 0 0 0 3px rgba(185, 122, 60, .12); }
.document-empty-state { align-items: center; color: var(--myc-soft-text); display: grid; gap: 7px; justify-items: center; min-height: 190px; padding: 30px; text-align: center; }
.document-empty-state strong { color: var(--myc-navy); font-size: 16px; }
.document-detail-modal { height: 85vh; max-height: 85vh; max-width: none; padding: 0; width: 90vw; }
.document-detail-header { align-items: flex-start; display: flex; gap: 18px; justify-content: space-between; padding: 22px 24px 16px; }
.document-detail-header p { color: var(--myc-primary); font-size: 12px; font-weight: 900; letter-spacing: .08em; margin: 0 0 5px; text-transform: uppercase; }
.document-detail-header h2 { color: var(--myc-navy); font-size: 24px; margin: 0 0 9px; }
.document-detail-actions { align-items: center; display: flex; gap: 8px; }
.document-detail-actions .ghost-button { align-items: center; display: inline-flex; gap: 7px; }
.document-identity-card { flex: 1 1 auto; min-width: 0; }
.document-identity-main { min-width: 0; }
.document-identity-facts { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 13px; }
.document-identity-facts > span { display: grid; gap: 4px; min-width: 92px; }
.document-identity-facts small { color: var(--myc-soft-text); font-size: 10px; font-weight: 850; text-transform: uppercase; }
.document-identity-facts strong:not(.status-pill) { color: var(--myc-navy); font-size: 13px; }
.document-obsolete-button { align-items: center; background: rgba(156, 60, 60, .06); border: 1px solid rgba(156, 60, 60, .2); border-radius: 8px; color: #8a3434; display: inline-flex; font-size: 12px; font-weight: 850; gap: 6px; min-height: 38px; padding: 0 11px; }
.document-close-button { white-space: nowrap; }
.document-detail-tabs { background: rgba(255, 255, 255, .34); border-bottom: 1px solid rgba(8, 117, 111, .14); border-top: 1px solid rgba(8, 117, 111, .1); display: flex; gap: 4px; overflow-x: auto; padding: 7px 22px 0; }
.document-detail-tabs button { background: transparent; border: 0; border-bottom: 3px solid transparent; color: var(--myc-soft-text); flex: 0 0 auto; font-weight: 850; min-height: 42px; padding: 0 15px; }
.document-detail-tabs button:hover { background: rgba(232, 250, 247, .42); color: var(--myc-primary-dark); }
.document-detail-tabs button.is-active { background: rgba(232, 250, 247, .62); border-bottom-color: var(--myc-primary); color: var(--myc-primary-dark); }
.document-detail-content { height: calc(85vh - 174px); min-height: 0; overflow: auto; padding: 22px 24px 28px; }
.document-detail-list { display: grid; gap: 1px; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; overflow: hidden; }
.document-detail-list div { background: rgba(255, 255, 255, .38); border: 1px solid rgba(8, 117, 111, .1); min-height: 76px; padding: 12px; }
.document-detail-list dt { color: var(--myc-soft-text); font-size: 11.5px; font-weight: 850; margin-bottom: 6px; text-transform: uppercase; }
.document-detail-list dd { color: var(--myc-navy); font-size: 14px; font-weight: 800; margin: 0; overflow-wrap: anywhere; }
.document-description { background: rgba(255, 255, 255, .34); border: 1px solid rgba(8, 117, 111, .1); border-radius: 8px; margin-top: 14px; padding: 15px; }
.document-description span { color: var(--myc-soft-text); font-size: 11.5px; font-weight: 850; text-transform: uppercase; }
.document-description p { color: var(--myc-text); line-height: 1.55; margin: 8px 0 0; }
.document-information-panel { display: grid; gap: 15px; }
.document-info-group { background: rgba(255,255,255,.2); border: 1px solid rgba(8,117,111,.09); border-radius: 8px; overflow: hidden; }
.document-info-group > header { padding: 14px 15px 10px; }
.document-info-group > header p { color: var(--myc-primary); font-size: 10.5px; font-weight: 850; margin: 0 0 3px; text-transform: uppercase; }
.document-info-group > header h3 { color: var(--myc-navy); font-size: 16px; margin: 0; }
.document-tab-heading { align-items: center; display: flex; gap: 16px; justify-content: space-between; margin-bottom: 16px; }
.document-tab-heading p { color: var(--myc-primary); font-size: 12px; font-weight: 850; margin: 0 0 4px; text-transform: uppercase; }
.document-tab-heading h3 { color: var(--myc-navy); margin: 0; }
.document-versions-grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); }
.document-version-card { background: rgba(255, 255, 255, .34); border: 1px solid rgba(8, 117, 111, .13); border-radius: 8px; padding: 16px; }
.document-version-card.is-active { background: rgba(219, 248, 243, .58); border-color: rgba(8, 117, 111, .35); box-shadow: inset 4px 0 var(--myc-primary); }
.document-version-card > header { align-items: center; display: flex; justify-content: space-between; margin-bottom: 12px; }
.document-version-card > header div { display: grid; gap: 2px; }
.document-version-card > header span { color: var(--myc-soft-text); font-size: 11px; font-weight: 850; text-transform: uppercase; }
.document-version-card > header strong { color: var(--myc-navy); font-size: 20px; }
.document-version-card .document-detail-list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.document-version-card .document-detail-list div { min-height: 68px; }
.document-version-card > p { color: var(--myc-soft-text); font-size: 13px; line-height: 1.5; }
.document-version-card .secondary-button { margin-top: 8px; }
.document-history { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); padding: 4px 2px; }
.document-history article { background: rgba(255,255,255,.34); border: 1px solid rgba(8,117,111,.12); border-left: 3px solid rgba(8, 117, 111, .35); border-radius: 8px; display: grid; gap: 14px; grid-template-columns: 38px 1fr; min-height: 112px; padding: 16px; position: relative; }
.document-history article > span { align-items: center; background: var(--myc-primary); border-radius: 50%; color: white; display: flex; height: 30px; justify-content: center; left: -16px; position: absolute; top: 0; width: 30px; }
.document-history article > span { left: 14px; top: 16px; }
.document-history article > div { grid-column: 2; }
.document-history time { color: var(--myc-soft-text); display: block; font-size: 12px; font-weight: 750; }
.document-history strong { color: var(--myc-navy); display: block; margin-top: 3px; }
.document-history p { color: var(--myc-soft-text); margin: 5px 0 0; }
.document-publication-panel { display: grid; gap: 18px; }
.document-publication-state { align-items: flex-start; background: rgba(255, 255, 255, .42); border: 1px solid rgba(8, 117, 111, .14); border-radius: 8px; color: var(--myc-soft-text); display: flex; gap: 16px; padding: 18px; }
.document-publication-state.is-active { background: rgba(219, 248, 243, .62); color: var(--myc-primary); }
.document-publication-state span { color: var(--myc-soft-text); font-size: 11.5px; font-weight: 850; text-transform: uppercase; }
.document-publication-state h3 { color: var(--myc-navy); margin: 4px 0 7px; }
.document-publication-state p { color: var(--myc-soft-text); line-height: 1.5; margin: 0; }
.document-publication-badges { align-items: center; display: flex; flex-wrap: wrap; gap: 9px; margin: 7px 0 9px; }
.document-publication-badges em { background: rgba(255,255,255,.48); border: 1px solid rgba(8,117,111,.12); border-radius: 999px; color: var(--myc-soft-text); font-size: 11px; font-style: normal; font-weight: 800; padding: 5px 9px; }
.document-designer-placeholder { align-items: center; display: grid; justify-items: center; margin: auto; max-width: 620px; padding: 34px 20px; text-align: center; }
.document-designer-placeholder > span { align-items: center; background: rgba(8, 117, 111, .12); border-radius: 50%; color: var(--myc-primary); display: flex; height: 72px; justify-content: center; width: 72px; }
.document-designer-placeholder > p:first-of-type { color: var(--myc-primary); font-size: 12px; font-weight: 850; margin: 15px 0 5px; text-transform: uppercase; }
.document-designer-placeholder h3 { color: var(--myc-navy); font-size: 24px; margin: 0; }
.document-designer-placeholder > p:last-of-type { color: var(--myc-soft-text); line-height: 1.55; }
.document-designer-placeholder > div { background: rgba(255, 255, 255, .42); border: 1px solid rgba(8, 117, 111, .12); border-radius: 8px; display: grid; gap: 5px; margin: 8px 0 18px; min-width: 300px; padding: 13px; }
.document-designer-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; }
.document-designer-facts > span { display: grid; gap: 5px; padding: 5px 10px; }
.document-designer-placeholder small { color: var(--myc-soft-text); font-weight: 750; }
.document-designer-placeholder strong { color: var(--myc-navy); }
.document-designer-placeholder button { align-items: center; display: inline-flex; gap: 9px; }
.document-designer-placeholder em { background: rgba(255,255,255,.4); border-radius: 999px; font-size: 10px; font-style: normal; padding: 3px 7px; text-transform: uppercase; }
.document-form-modal { max-width: 820px; }
.document-form-grid { display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 0 24px; }
.document-form-grid label { color: var(--myc-soft-text); display: grid; font-size: 12.5px; font-weight: 850; gap: 6px; }
.document-form-grid label small { color: var(--myc-soft-text); font-size: 10.5px; font-weight: 650; line-height: 1.35; }
.document-form-grid textarea { min-height: 90px; resize: vertical; }
.document-form-wide { grid-column: 1 / -1; }
.document-form-actions { align-items: center; display: flex; gap: 9px; justify-content: flex-end; padding: 20px 24px 4px; }
.document-reference-note { background: rgba(219, 248, 243, .5); border: 1px solid rgba(8, 117, 111, .14); border-radius: 8px; color: var(--myc-soft-text); margin: 0 24px 16px; padding: 12px; }

@media (max-width: 900px) {
  .document-control-hero { align-items: flex-start; flex-wrap: wrap; }
  .document-control-hero .primary-button { margin-left: 80px; }
  .document-catalog-heading { align-items: stretch; flex-direction: column; }
  .document-subnav { align-items: stretch; flex-direction: column; }
  .document-subnav__action { width: 100%; }
  .document-catalog-filters { grid-template-columns: 1fr 1fr; width: 100%; }
  .document-search { grid-column: 1 / -1; }
  .document-detail-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .document-version-card .document-detail-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .document-control-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .document-detail-header { flex-direction: column; }
  .document-detail-actions { flex-wrap: wrap; width: 100%; }
  .document-detail-modal { height: 90vh; max-height: 90vh; width: 94vw; }
  .document-detail-content { height: calc(90vh - 236px); }
  .document-versions-grid,
.document-history { grid-template-columns: 1fr; }
}

@media (max-width: 640px) {
  .document-control-summary { grid-template-columns: 1fr; }
  .document-control-hero .primary-button { margin-left: 0; width: 100%; }
  .document-catalog-filters { grid-template-columns: 1fr; }
  .document-subnav__tabs { display: grid; grid-template-columns: 1fr 1fr; }
  .document-search { grid-column: auto; }
  .document-detail-modal { border-radius: 0; height: 100vh; max-height: 100vh; min-height: 100vh; width: 100%; }
  .document-detail-header { padding: 18px 16px 13px; }
  .document-detail-header h2 { font-size: 20px; }
  .document-detail-actions .ghost-button { padding: 9px; }
  .document-detail-actions .ghost-button svg { margin: 0; }
  .document-detail-tabs { padding-inline: 12px; }
  .document-detail-content { height: calc(100vh - 260px); padding: 17px 15px 24px; }
  .document-detail-list,
.document-version-card .document-detail-list { grid-template-columns: 1fr; }
  .document-tab-heading { align-items: stretch; flex-direction: column; }
  .document-form-grid { grid-template-columns: 1fr; padding-inline: 16px; }
  .document-form-wide { grid-column: auto; }
  .document-reference-note { margin-inline: 16px; }
  .document-form-actions { padding-inline: 16px; }
  .document-designer-placeholder > div { min-width: 0; width: 100%; }
  .document-designer-facts { grid-template-columns: 1fr; }
}

.ets-autosave-status {
  align-items: center;
  background: rgba(255, 255, 255, 0.42);
  border: 1px solid rgba(201, 255, 247, 0.46);
  border-radius: 8px;
  display: flex;
  gap: 10px;
  margin: -6px 0 12px;
  min-height: 48px;
  padding: 8px 12px;
}

.ets-autosave-status__dot {
  background: #64748b;
  border-radius: 999px;
  flex: 0 0 auto;
  height: 9px;
  width: 9px;
}

.ets-autosave-status > div {
  display: grid;
  gap: 2px;
  min-width: 0;
}

.ets-autosave-status strong {
  color: var(--myc-navy);
  font-size: 13px;
  font-weight: 900;
}

.ets-autosave-status small {
  color: var(--myc-soft-text);
  font-size: 11px;
  font-weight: 750;
  overflow-wrap: anywhere;
}

.ets-autosave-status .table-button {
  margin-left: auto;
}

.ets-autosave-status.is-pending {
  background: rgba(255, 251, 235, 0.74);
  border-color: rgba(217, 119, 6, 0.24);
}

.ets-autosave-status.is-pending .ets-autosave-status__dot {
  background: #d97706;
}

.ets-autosave-status.is-saving {
  background: rgba(239, 246, 255, 0.76);
  border-color: rgba(37, 99, 235, 0.22);
}

.ets-autosave-status.is-saving .ets-autosave-status__dot {
  animation: ets-autosave-pulse 900ms ease-in-out infinite;
  background: #2563eb;
}

.ets-autosave-status.is-saved {
  background: rgba(236, 253, 245, 0.74);
  border-color: rgba(5, 150, 105, 0.22);
}

.ets-autosave-status.is-saved .ets-autosave-status__dot {
  background: #059669;
}

.ets-autosave-status.is-error {
  background: rgba(254, 242, 242, 0.82);
  border-color: rgba(220, 38, 38, 0.24);
}

.ets-autosave-status.is-error .ets-autosave-status__dot {
  background: #dc2626;
}

@keyframes ets-autosave-pulse {
  0%,
  100% {
    opacity: 0.45;
    transform: scale(0.82);
  }

  50% {
    opacity: 1;
    transform: scale(1.18);
  }
}

/* ==========================================================================
   MYC DESIGN SYSTEM V2 — GLOBAL REBRAND LAYER
   Este bloque prevalece sobre estilos legacy sin alterar la estructura.
   ========================================================================== */

html,
body {
  background: var(--myc-bg);
  color: var(--myc-text);
}

body {
  min-height: 100vh;
}

::selection {
  background: rgba(61, 183, 179, 0.28);
  color: var(--myc-text);
}

input::placeholder,
textarea::placeholder {
  color: var(--myc-placeholder);
  opacity: 1;
}

/* Fondo global: menos luminosidad,
más profundidad visual. */
.loading-screen,
.auth-screen,
.app-shell {
  background:
    radial-gradient(circle at 82% 12%, rgba(61, 183, 179, 0.18), transparent 34%),
    radial-gradient(circle at 16% 84%, rgba(11, 106, 117, 0.15), transparent 38%),
    linear-gradient(145deg, var(--myc-sidebar) 0%, var(--myc-sidebar-alt) 31%, #64858a 64%, var(--myc-bg) 100%);
}

.app-shell--module,
.app-shell--dashboard {
  background:
    radial-gradient(circle at 85% 10%, rgba(61, 183, 179, 0.16), transparent 32%),
    linear-gradient(145deg, #23464c 0%, #527176 28%, var(--myc-bg) 76%, #d3dddf 100%);
}

/* Liquid Glass compartido */
.topbar,
.workspace-header__summary,
.flow-strip,
.module-card,
.operations-band,
.dashboard-control-panel,
.dashboard-section-block,
.module-workspace__hero,
.module-workspace__panel,
.clients-list-panel,
.client-modal,
.module-tabs,
.document-library-panel,
.pattern-selection-panel {
  backdrop-filter: blur(16px) saturate(126%);
  -webkit-backdrop-filter: blur(16px) saturate(126%);
  border-color: var(--glass-border);
  box-shadow: var(--glass-shadow);
}

.topbar,
.workspace-header__summary,
.flow-strip,
.operations-band,
.dashboard-control-panel,
.dashboard-section-block,
.module-workspace__hero,
.module-workspace__panel,
.clients-list-panel,
.module-tabs {
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.34), rgba(61, 183, 179, 0.08)),
    var(--glass-bg);
}

.module-card {
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.34), rgba(61, 183, 179, 0.08) 48%, rgba(255, 255, 255, 0.12)),
    var(--glass-bg);
}

.module-card:hover {
  border-color: rgba(61, 183, 179, 0.52);
  box-shadow: var(--glass-shadow-strong);
}

/* Sidebar */
.sidebar {
  background:
    linear-gradient(180deg, rgba(8, 43, 48, 0.96), rgba(12, 56, 64, 0.94));
  border-right-color: rgba(125, 220, 211, 0.16);
}

.nav-item {
  background: rgba(255, 255, 255, 0.075);
  color: rgba(241, 249, 249, 0.92);
}

.nav-item:hover {
  background: rgba(61, 183, 179, 0.16);
}

.nav-item.is-active,
.nav-item[aria-current="page"] {
  background: rgba(61, 183, 179, 0.20);
  border-color: rgba(125, 220, 211, 0.30);
  color: #ffffff;
}

.nav-item--lab {
  background: rgba(61, 183, 179, 0.10);
  border-color: rgba(125, 220, 211, 0.16);
}

/* Tipografía y jerarquía */
.workspace-header h1,
.module-workspace__hero h1,
.module-workspace__panel h2,
.section-heading h2,
.topbar__identity strong,
.clients-table__head,
.read-only-grid strong {
  color: var(--myc-navy);
}

.workspace-header span,
.module-workspace__hero span,
.module-workspace__panel p,
.module-card p,
.clients-table__row,
.field-sheet-form-grid label,
.client-form label,
.inline-select-field,
.ets-stage-note {
  color: var(--myc-muted);
}

/* Superficies operativas */
.clients-table__row,
.ets-summary-card,
.ets-summary-link,
.ets-work-order-folder,
.ets-signature-card,
.glass-card-mini,
.read-only-grid article,
.field-sheet-create-section,
.field-sheet-client-choice,
.field-sheet-client-summary,
.ets-field-sheet-work-order,
.ets-field-sheet-equipment-row,
.document-version-list button,
.document-version-list span {
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.30), rgba(255, 255, 255, 0.12)),
    var(--glass-bg-soft);
  border-color: var(--myc-line);
  color: var(--myc-text);
}

.clients-table__row--clickable:hover,
.quotation-row-button:hover,
.quotation-row-button:focus-visible,
.ets-summary-card:hover,
.ets-summary-card:focus-visible {
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.40), rgba(61, 183, 179, 0.12)),
    var(--glass-bg);
  border-color: rgba(11, 106, 117, 0.34);
}

/* Controles */
input,
select,
textarea,
.document-library-form input,
.document-library-form select,
.document-library-form textarea,
.document-library-filters input,
.document-library-filters select,
.client-form input,
.client-form select,
.client-form textarea,
.field-sheet-form-grid input,
.field-sheet-form-grid select,
.field-sheet-form-grid textarea,
.field-sheet-create-field input,
.field-sheet-create-field select,
.certificate-client-form input,
.certificate-client-form textarea,
.certificate-client-save-options input,
.inline-select-field select,
.ets-expedient-search input,
.field-sheet-results-row input {
  background: color-mix(in srgb, var(--myc-input) 88%, transparent);
  border-color: var(--myc-border);
  color: var(--myc-text);
}

input:focus,
select:focus,
textarea:focus,
.client-form input:focus,
.client-form select:focus,
.client-form textarea:focus,
.field-sheet-form-grid input:focus,
.field-sheet-form-grid select:focus,
.field-sheet-form-grid textarea:focus {
  border-color: var(--myc-primary);
  box-shadow: 0 0 0 3px rgba(61, 183, 179, 0.16);
  outline: none;
}

/* Botones */
.primary-button,
.table-button--primary {
  background: linear-gradient(135deg, var(--myc-primary), var(--myc-primary-hover));
  color: #ffffff;
}

.primary-button:hover,
.table-button--primary:hover {
  background: linear-gradient(135deg, var(--myc-primary-hover), var(--myc-primary-active));
}

.icon-text-button,
.table-button,
.sidebar-collapse-button,
.sidebar-mobile-close,
.sidebar-menu-button {
  border-color: var(--myc-line);
}

.icon-text-button,
.table-button {
  background: rgba(255, 255, 255, 0.40);
  color: var(--myc-primary-dark);
}

.icon-text-button:hover,
.table-button:hover {
  background: rgba(255, 255, 255, 0.58);
  border-color: rgba(11, 106, 117, 0.32);
}

/* Estados semánticos */
.status-pill,
.quotation-status.status-accepted,
.quotation-status.status-approved,
.quotation-status.status-released,
.quotation-status.status-completed,
.quotation-status.status-calibrated,
.quotation-status.status-labeled {
  background: rgba(45, 140, 99, 0.12);
  border-color: rgba(45, 140, 99, 0.28);
  color: #216f4e;
}

.quotation-status.status-pending,
.quotation-status.status-progress,
.ets-stage-badge.is-reopened,
.ets-inline-stage.is-reopened,
.ets-stage.is-reopened {
  background: rgba(210, 154, 26, 0.14);
  border-color: rgba(210, 154, 26, 0.28);
  color: #805c0f;
}

.status-pill--danger,
.quotation-status.status-rejected,
.quotation-status.status-expired,
.quotation-status.status-cancelled,
.quotation-status.status-suspended,
.quotation-status.status-not_done,
.ets-stage-badge.is-blocked,
.ets-inline-stage.is-blocked,
.ets-stage.is-blocked {
  background: rgba(196, 74, 71, 0.12);
  border-color: rgba(196, 74, 71, 0.28);
  color: #913a38;
}

/* ==========================================================================
   DARK MODE
   Compatible con data-theme="dark",
.dark,
.dark-theme y .theme-dark.
   ========================================================================== */

:root[data-theme="dark"],
html[data-theme="dark"],
body[data-theme="dark"],
:root.dark,
html.dark,
body.dark,
body.dark-theme,
.theme-dark {
  color-scheme: dark;

  --myc-primary: #66d7d0;
  --myc-primary-dark: #66d7d0;
  --myc-primary-hover: #7de3dc;
  --myc-primary-active: #4fc1ba;
  --myc-accent: #45bdb5;
  --myc-accent-soft: rgba(69, 189, 181, 0.16);

  --myc-navy: #e5efef;
  --myc-exeption: #20343a;

  --myc-bg: #0c171b;
  --myc-surface: #122126;
  --myc-surface-1: #122126;
  --myc-surface-2: #182a30;
  --myc-surface-3: #20343a;
  --myc-input: #16262b;

  --myc-text: #e5efef;
  --myc-muted: #a7b9ba;
  --myc-soft-text: #a7b9ba;
  --myc-placeholder: #778b8e;

  --myc-border: #31474c;
  --myc-divider: #263b40;
  --myc-line: rgba(102, 215, 208, 0.18);

  --myc-sidebar: #071216;
  --myc-sidebar-alt: #0c252b;

  --myc-success: #56b88b;
  --myc-warning: #e2b44a;
  --myc-danger: #dd7774;
  --myc-info: #67a9df;

  --glass-bg: rgba(22, 42, 48, 0.62);
  --glass-bg-strong: rgba(27, 51, 58, 0.82);
  --glass-bg-soft: rgba(22, 42, 48, 0.42);
  --glass-border: rgba(125, 220, 211, 0.18);
  --glass-shadow: 0 20px 55px rgba(0, 0, 0, 0.32);
  --glass-shadow-strong: 0 26px 72px rgba(0, 0, 0, 0.42);
  --glass-highlight: rgba(206, 255, 249, 0.12);
}

:root[data-theme="dark"] body,
html[data-theme="dark"] body,
body[data-theme="dark"],
:root.dark body,
html.dark body,
body.dark,
body.dark-theme,
.theme-dark {
  background: var(--myc-bg);
  color: var(--myc-text);
}

:root[data-theme="dark"] .app-shell,
html[data-theme="dark"] .app-shell,
body[data-theme="dark"] .app-shell,
.dark .app-shell,
.dark-theme .app-shell,
.theme-dark .app-shell {
  background:
    radial-gradient(circle at 78% 14%, rgba(69, 189, 181, 0.10), transparent 32%),
    linear-gradient(145deg, #071216 0%, #0c252b 42%, #0c171b 100%);
}

