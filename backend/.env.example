APP_NAME="ERP MYC"
APP_VERSION="0.4.0"
ENVIRONMENT="development"
DATABASE_URL="postgresql+psycopg://localhost:5432/erp_myc"
SECRET_KEY="change-this-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=480
STORAGE_ROOT="storage"

# Conversión XLSX → PDF. Acepta una ruta absoluta o un comando disponible en PATH.
# macOS: /Applications/LibreOffice.app/Contents/MacOS/soffice
# Windows: C:\Program Files\LibreOffice\program\soffice.exe
# Linux: /usr/bin/soffice
LIBREOFFICE_EXECUTABLE=
OFFICE_CONVERTER_TIMEOUT_SECONDS=60

# Facturama
FACTURAMA_ENABLED=false
FACTURAMA_ENVIRONMENT=sandbox
FACTURAMA_USERNAME=
FACTURAMA_PASSWORD=
FACTURAMA_SANDBOX_URL=https://apisandbox.facturama.mx
FACTURAMA_PRODUCTION_URL=https://api.facturama.mx
FACTURAMA_TIMEOUT_SECONDS=30
