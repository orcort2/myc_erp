APP_NAME="ERP MYC"
APP_VERSION="0.4.0"
ENVIRONMENT="development"
DATABASE_URL="postgresql+psycopg://localhost:5432/erp_myc"
# Sólo desarrollo local. Producción rechaza este ejemplo y exige un secreto
# aleatorio de al menos 32 caracteres y 100 bits estimados de entropía.
SECRET_KEY="development-only-change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=480
STORAGE_ROOT="storage"
# Límites institucionales de carga (bytes). El backend valida nombre,
# extensión, MIME, firma real y, para ZIP/Office, expansión y rutas internas.
UPLOAD_ACTIVITY_MAX_BYTES=15728640
UPLOAD_CAPTURE_MAX_BYTES=41943040
UPLOAD_DOCUMENT_MAX_BYTES=20971520
UPLOAD_CERTIFICATE_PDF_MAX_BYTES=26214400
UPLOAD_TAX_CONSTANCY_MAX_BYTES=15728640
UPLOAD_ARCHIVE_MAX_MEMBERS=250
UPLOAD_ARCHIVE_MAX_UNCOMPRESSED_BYTES=125829120
UPLOAD_ARCHIVE_MAX_MEMBER_BYTES=26214400
UPLOAD_ARCHIVE_MAX_RATIO=100
UPLOAD_ARCHIVE_MAX_DEPTH=8
UPLOAD_IMAGE_MAX_PIXELS=40000000
ENABLE_API_DOCS=true
ENABLE_DEVELOPER_PORTAL=true

# Conversión XLSX → PDF. Acepta una ruta absoluta o un comando disponible en PATH.
# macOS: /Applications/LibreOffice.app/Contents/MacOS/soffice
# Windows: C:\Program Files\LibreOffice\program\soffice.exe
# Linux: /usr/bin/soffice
LIBREOFFICE_EXECUTABLE=
OFFICE_CONVERTER_TIMEOUT_SECONDS=60

# Facturama
FACTURAMA_ENABLED=false
FACTURAMA_ENVIRONMENT=sandbox
FACTURAMA_USERNAME=
FACTURAMA_PASSWORD=
FACTURAMA_SANDBOX_URL=https://apisandbox.facturama.mx
FACTURAMA_PRODUCTION_URL=https://api.facturama.mx
FACTURAMA_TIMEOUT_SECONDS=30
